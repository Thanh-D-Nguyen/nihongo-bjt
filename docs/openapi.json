{
  "openapi": "3.0.0",
  "info": {
    "title": "KotobaWorks Go mobile API",
    "version": "1.0.0",
    "description": "Verified mobile-facing contract for apps/api-go. This document intentionally contains only routes verified against the Go router and handler tests; it is not a catalogue of the retired NestJS API."
