        "x-verification": ["apps/api-go/internal/httpserver/handler_login_test.go"],
        "x-ios": { "originOrRefererRequired": true, "originOrRefererMustBeTrusted": true, "tokenTransport": "Save token from the body and send Authorization: Bearer <token>. Do not treat it as a JWT or refresh token." }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication"], "operationId": "learnerMe", "security": [{ "learnerSession": [] }, { "learnerCookie": [] }],
        "responses": { "200": { "description": "Authenticated learner; flat profile object", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LearnerFullProfile" } } } }, "401": { "$ref": "#/components/responses/Error401" }, "500": { "$ref": "#/components/responses/Error500" } },
        "x-verification": ["apps/api-go/internal/httpserver/handler_profile_test.go"]
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"], "operationId": "learnerLogout", "security": [{ "learnerSession": [] }, { "learnerCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/Origin" }, { "$ref": "#/components/parameters/Referer" }],
        "responses": { "200": { "description": "Current session revoked", "headers": { "Set-Cookie": { "schema": { "type": "string" }, "description": "Clears bjt_web_session." } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkResponse" } } } }, "401": { "$ref": "#/components/responses/Error401" }, "403": { "$ref": "#/components/responses/Error403" }, "500": { "$ref": "#/components/responses/Error500" } },
