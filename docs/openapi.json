        "x-ios": { "originOrRefererRequired": true, "inFlight": "A response from an already-started request may still arrive after logout. The client must discard it after local session state is cleared." }
      }
    },
    "/api/content/lexemes": {
      "get": { "tags": ["Content"], "operationId": "listLexemes", "parameters": [{ "$ref": "#/components/parameters/Q" }, { "name": "jlptLevel", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Active lexemes", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/LexemeSummary" } } } } }, "500": { "$ref": "#/components/responses/Error500" } }, "x-verification": ["apps/api-go/internal/httpserver/server.go", "apps/api-go/internal/httpserver/handler_career_content_gamification_misc.go"] }
