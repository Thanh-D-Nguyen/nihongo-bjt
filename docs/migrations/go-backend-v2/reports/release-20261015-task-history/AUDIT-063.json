  "spec": {
    "problem": "Learner Battle UI speaks Socket.IO to an endpoint that only serves authenticated JSON WebSocket, leaving the match action permanently reconnecting; current Go handler also ignores the UI battle lifecycle events.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Authenticated visible learner can open the lobby over the canonical Go WebSocket, join and send persisted global chat, start a bot match from existing published BJT questions, submit an answer, see canonical feedback/result, and retain the completed score after refresh; all identity and answer correctness are derived server-side, and no vocabulary/kanji/grammar or BJT question content is created/edited/deleted."
      },
      {
        "id": "AC2",
        "text": "Anonymous/invalid sessions cannot upgrade; unrelated users cannot read or mutate another battle; malformed/duplicate answers do not alter score; disconnect/reconnect never causes an infinite retry loop."
      }
    ],
    "expected_behavior": "Use authenticated /ws/battle with bounded reconnects; server-owned identity, canonical published BJT questions and persisted battle sessions/round results drive the bot learning flow, and current UI displays feedback and saved result.",
    "observed_behavior": "Visible authenticated 390x844 Battle Lobby has loaded bot/config data but shows reconnecting and keeps Start disabled; frontend emits Socket.IO lobby/chat/challenge/answer events while Go only accepts JSON frames at /ws/battle.",
    "rollback_plan": "Revert the Battle WebSocket client adapter, provider migration, Go realtime handler/database wiring, and their tests. No schema migration or canonical content mutation is required; integration fixtures are disposable and cleaned on teardown."
  },
  "classification": {
    "classes": [
      "REALTIME",
      "API_CONTRACT",
      "AUTH_SECURITY",
      "DOMAIN_LOGIC",
      "DATABASE",
      "CROSS_CUTTING",
