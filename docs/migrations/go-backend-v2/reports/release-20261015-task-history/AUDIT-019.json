  "spec": {
    "problem": "The publish handler ignores status-update and audit SQL errors, so the API can report success and write an audit entry without publishing.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "PostgreSQL integration regression forces the fixture status update to fail, verifies HTTP 500 and no publish audit row, while the existing visible Admin request proves a successful draft transition and audit."
      }
    ],
    "expected_behavior": "Publish status change and audit entry commit atomically; any failed write returns 500 and leaves the exam draft with no publish audit event.",
    "observed_behavior": "Source review shows both db.Exec errors are discarded; reproduce an UPDATE rejection against a disposable draft in PostgreSQL and assert the response does not claim success.",
    "rollback_plan": "Revert the handler transaction and its PostgreSQL regression test; the existing publish behavior remains available."
  },
