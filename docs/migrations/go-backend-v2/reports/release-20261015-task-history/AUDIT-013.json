  "spec": {
    "problem": "Admin search analytics is bound to a nonexistent query log table despite search events being persisted in the canonical analytics event table.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Search analytics maps to analytics.analytics_event, returns correct summary/timeseries/source breakdown and export from PostgreSQL fixtures, and unavailable click-through metrics are explicit."
      }
    ],
    "expected_behavior": "Search analytics reads canonical search events, reports measurable query metrics and by-source breakdowns, and marks click-through unavailable because no click event exists.",
    "observed_behavior": "Visible GET /api/admin/analytics/search/breakdown returns HTTP 500; canonical learner events are content_search_submitted with source and resultCount payload in analytics.analytics_event.",
    "rollback_plan": ""
  },
