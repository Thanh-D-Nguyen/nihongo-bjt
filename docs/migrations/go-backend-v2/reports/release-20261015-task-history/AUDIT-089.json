  "spec": {
    "problem": "Learner Privacy Policy tells readers to open Settings > Privacy or the Feedback page, but those references are plain text and cannot take readers to the actual data controls or support route.",
    "observed_behavior": "The public policy renders localized body copy without working links from the data-rights and contact sections.",
    "expected_behavior": "In vi/en/ja, the data-rights section exposes a localized link to the learner privacy settings, and the contact section exposes a localized link to Feedback; the policy remains public and fits a 390x844 viewport.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous /:locale/privacy renders the five policy sections and locale-specific metadata/copy for vi, en and ja."
      },
      {
        "id": "AC2",
        "text": "The data-rights and contact sections expose keyboard-accessible, locale-preserving links to /:locale/settings/privacy and /:locale/feedback."
      },
      {
        "id": "AC3",
        "text": "At 390x844 the policy has no horizontal overflow and linked destinations resolve on the public learner origin."
      }
    ],
    "rollback_plan": "Revert only the Privacy Policy page link rendering, its localized link labels, and regression test; no user or policy data is changed."
  },
