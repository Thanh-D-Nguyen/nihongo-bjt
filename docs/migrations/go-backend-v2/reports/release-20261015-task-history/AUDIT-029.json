  "spec": {
    "problem": "GET /api/analytics/learner treats invalid days values (0, above 365, nonnumeric) as database failures but responds with HTTP 200 and fabricated empty statistics.",
    "acceptance": [
      {
        "id": "days_validation",
        "text": "days defaults to 7 and accepts integers from 1 through 365; invalid values return 400."
      },
      {
        "id": "session_scope",
        "text": "Daily analytics and the echoed userId are derived only from the authenticated learner session."
      },
      {
        "id": "read_contract",
        "text": "Valid requests return the documented dailyStats and totals contract; anonymous requests return 401."
      }
    ],
    "expected_behavior": "Valid learner analytics requests return only the current session user’s aggregates; malformed or out-of-range days is a 400; query failures are not reported as empty success.",
    "observed_behavior": "A real authenticated browser request with days=0, 366 or abc returns 200 and empty data; valid request returns session-scoped totals.",
    "rollback_plan": "Revert handler and integration test together, retaining LearnerGuard and existing context identity."
  },
