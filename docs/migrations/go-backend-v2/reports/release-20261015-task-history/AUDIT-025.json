  "spec": {
    "problem": "The learner AdSlot never renders because POST /api/ads/decision returns a legacy static {showAd:false, placementCode:\"\", reason:\"anonymous_stub\"} response, while AdSlot requires eligible, decisionToken and payload.campaign. The local database has an active approved storefront campaign attached to home_feed_inline.",
    "observed_behavior": "Visible learner home sent POST /api/ads/decision for home_feed_inline and received HTTP 200 with the static no-ad response; no sponsored slot rendered despite an active local campaign.",
    "expected_behavior": "Return the frontend AdDecision contract for an eligible active campaign and its active placement, respecting campaign dates, policy status, provider enabled state and target locale; return an explicit ineligible contract when there is no match. Do not expose draft/rejected campaigns.",
    "acceptance": [
      {
        "id": "active-campaign",
        "text": "Visible learner home renders the eligible storefront campaign and its destination anchor when local campaign is active and policy-approved."
      },
      {
        "id": "no-campaign",
        "text": "A POST decision for a placement with no eligible campaign returns 200 with eligible=false and no campaign payload; frontend safely renders no slot."
      },
      {
        "id": "eligibility",
        "text": "Campaign and placement filtering is exercised with PostgreSQL integration tests, including inactive/rejected/locale mismatch cases."
      },
      {
        "id": "visible-flow",
        "text": "Real response is observed in the visible browser Network flow and the home AdSlot uses it without console/page errors."
      }
    ],
    "rollback_plan": "Revert the decision handler, route wiring, and focused regression tests; the public decision route returns to the current static no-ad response."
  },
