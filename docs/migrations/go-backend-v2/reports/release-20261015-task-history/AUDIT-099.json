  "spec": {
    "problem": "Saved items used obsolete learner detail paths and rendered localized unknown titles even though canonical Go routes serve these records.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Saved tabs load only the authenticated learner’s records, expose truthful loading/error/empty states, and do not show private data anonymously."
      },
      {
        "id": "AC2",
        "text": "Saved word, kanji, and grammar entries resolve their visible title from the canonical Go content detail endpoints; unresolved or missing content uses localized fallback copy."
      },
      {
        "id": "AC3",
        "text": "Opening a saved entry preserves its target identity in the localized Search route; bookmark add/remove actions persist through the real learner UI and refresh."
      },
      {
        "id": "AC4",
        "text": "The Saved screen remains usable at 390x844 without horizontal overflow."
      }
    ],
    "expected_behavior": "Saved lexeme/grammar rows resolve their titles through registered canonical endpoints and keep the item identity in its Search deep link.",
    "observed_behavior": "On the visible authenticated Saved screen, a real saved lexeme rendered “Không lấy được tiêu đề”; the route source maps the vocabulary and grammar calls to paths not registered by Go. The Go API registers GET /api/content/lexemes/{id} and GET /api/content/grammar/{id}.",
    "rollback_plan": "Revert the two endpoint-path changes and focused Saved screen regression test."
  },
