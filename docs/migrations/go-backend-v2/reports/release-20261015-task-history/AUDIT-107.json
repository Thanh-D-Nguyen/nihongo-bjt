  "id": "AUDIT-107",
  "title": "Audit and repair learner scenario list",
  "start_head": "e70d90a61e43c1369c7bf1af7d8573d7c12473d4",
  "preexisting_changes": {},
  "spec": {
    "problem": "Learner Scenario list accesses synchronous Next route params, has no auth guard, keeps loading when auth is absent, masks non-2xx/network failures as an empty catalog, and uses Vietnamese interface copy on every locale. List row iteration also omits terminal database error handling.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Scenario list route awaits Next params and redirects anonymous users to localized login."
      },
      {
        "id": "AC2",
        "text": "Authenticated learners see localized loading, populated, truthful empty, and retryable API error states; failures are never presented as an empty catalog."
      },
      {
        "id": "AC3",
        "text": "Scenario cards show localized labels and navigate to the matching detail route in vi/en/ja."
      },
      {
        "id": "AC4",
        "text": "The visible list remains usable at a 390px viewport with no horizontal overflow."
      }
    ],
    "expected_behavior": "Await route params and use the learner auth guard. Authenticated learners see localized list content; actual empty data is distinct from request failure, which provides a localized retry. English/Japanese screens use localized controls and Japanese scenario title data when present. GET /api/scenarios returns complete rows or a surfaced error.",
    "observed_behavior": "Chrome emitted the Next sync params warning. A fresh anonymous session stayed on /vi/scenarios without content while the API returned 401. Source swallowed HTTP/network errors and showed empty state; list labels were hardcoded Vietnamese. The store did not inspect rows.Err().",
    "rollback_plan": "Revert only AUDIT-107 changes and its task record; preserve committed AUDIT-106 scenario detail and prior checkpoints."
  },
  "classification": {
    "classes": [
      "UI_ONLY",
      "AUTH_SECURITY",
