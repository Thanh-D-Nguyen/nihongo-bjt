  "spec": {
    "problem": "Oracle live Docker stack has no trusted main CI auto-release; old docs describe inactive systemd services",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Deploy only exact successful CI main push SHA on trusted ARM64 runner with serialization and CI verification"
      },
      {
        "id": "AC2",
        "text": "Preserve stateful env and mounts; build before switch; backup and migrate current Prisma and Go schema without seed/reset"
      },
      {
        "id": "AC3",
        "text": "Same-origin TLS web admin API; verify readiness and version; save rollback images and previous config; focused automated validation and independent review"
      }
    ],
    "expected_behavior": "Immutable CI-gated ARM64 builds preserve env/data and retain app-only rollback after safe migrations",
    "observed_behavior": "Existing Oracle services are project oci; private Compose uses /srv paths; /health/ready exposes release version",
    "rollback_plan": "Retain resolved previous Compose and pinned app/Caddy image tags plus prior Caddy config; rollback only app/Caddy, never automatically reverse database migrations; restore reviewed dump only through a separate operator recovery"
  },
  "classification": {
    "classes": [
      "INFRASTRUCTURE",
      "CI_QUALITY_SYSTEM"
    ],
    "change_kind": "add",
    "rationale": ""
  },
  "red_exception": {
    "category": "config_only",
    "reason": "Build/release configuration has no domain unit RED; validate composed config, shell syntax, mocked release failure paths and independent review. Live deployment outside authorized scope.",
    "declared_before_red": true
  },
