  "spec": {
    "problem": "Admin flashcard analytics uses a nonexistent session table and hides persisted review activity.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Flashcard analytics uses learning.review_event.reviewed_at as its event timestamp and rating as its breakdown dimension; a persisted review event appears in summary counts, its day bucket and the rating group."
      }
    ],
    "expected_behavior": "Flashcard summary, daily series, and breakdown use learning.review_event and accurately reflect persisted rating events.",
    "observed_behavior": "GET breakdown returned 200 with total=0 while the configured learning.flashcard_review_session relation does not exist; canonical migration defines learning.review_event(reviewed_at, rating, ...).",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "DOMAIN_LOGIC",
      "DATABASE",
      "API_CONTRACT"
    ],
    "change_kind": "bugfix",
    "rationale": "Align flashcard analytics queries with the canonical review_event schema and verify event counts by date and rating."
  },
