  "spec": {
    "problem": "Battle lobby Go handlers query columns and a table absent from canonical Prisma schema, swallow DB/row errors, and return successful empty arrays; frontend receives mismatched bot/config shapes.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET /api/battle/bots uses canonical active status and returns the frontend BattleBotStageProfile fields; GET /api/battle/configs/available returns published canonical config DTOs with correct active/upcoming state; authenticated GET /api/battle/chat/recent returns visible messages scoped by room and capped limit; DB/query/scan errors return 5xx instead of false empty 200; integration tests use disposable battle rows and clean them up without altering vocabulary, kanji, or grammar datasets."
      }
    ],
    "expected_behavior": "All three endpoints read canonical Battle schema and emit frontend DTOs; authenticated chat is room-scoped and only visible messages are returned; malformed/unavailable DB reads do not masquerade as empty success.",
    "observed_behavior": "GET bots queries active/display_order instead of status/order fields; GET configs queries persona/active and emits a legacy DTO; GET chat reads nonexistent battle.chat_message with sender_id/sender_name/sent_at and ignores room/limit.",
    "rollback_plan": "No schema migration or content edits. Revert the API handler/test files in the task commit; any disposable test fixtures are deleted by test cleanup."
  },
