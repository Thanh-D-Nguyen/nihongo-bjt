  "spec": {
    "problem": "The Admin referrals client expects a nested user object on list and detail responses, plus event and audit fields matching its types; the Go handlers expose flattened users and incomplete event fields. Revoke must remain functional and auditable.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET referrals list returns the Admin Summary shape with nested user and pagination; matching persisted events populate eventsLastHour/abuseFlag."
      },
      {
        "id": "AC2",
        "text": "GET referral detail returns the Summary shape plus schema-backed events and audit fields in the shape consumed by the Admin client."
      },
      {
        "id": "AC3",
        "text": "POST revoke as an authorized growth manager returns {id, revoked:true}, removes the referral code and writes the expected audit record."
      }
    ],
    "expected_behavior": "List and detail conform to the existing Admin caller and persisted ReferralCode/ReferralEvent schema; authorized revoke returns success, deletes the referral code, and records its audit event.",
    "observed_behavior": "List/detail currently serialize displayName and email at the top level; detail events omit kind, payload, referrerUserId and referredUserId. Revoke has no positive contract test in a separate owned test file.",
