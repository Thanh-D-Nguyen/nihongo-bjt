  "spec": {
    "problem": "POST /api/ads/impression is the active AdSlot impression caller but its Go handler only logs a stub and returns 204; the canonical monetization.ad_impression table is the persisted event source and Admin analytics counts these rows.",
    "observed_behavior": "Visible learner AdSlot dispatches an impression on intersection. The mounted API handler acknowledges it without writing any row.",
    "expected_behavior": "Validate the active placement and optional campaign/placement association, then persist an impression event with learner identity when available, decision key and client context. Preserve 204 on successful persistence and return a clear error when not recorded.",
    "acceptance": [
      {
        "id": "persist",
        "text": "Integration test posts a valid impression and verifies one canonical monetization.ad_impression row with campaign, placement, decision key and client context."
      },
      {
        "id": "invalid",
        "text": "Invalid body, missing/inactive placement and mismatched campaign are rejected without inserting an event."
      },
      {
        "id": "visible",
        "text": "Reload the visible learner page with AdSlot in view; inspect the actual same-origin impression request, verify persistence, then remove the disposable event."
      }
    ],
    "rollback_plan": "Revert the impression handler, route wiring and focused PostgreSQL regression tests; the endpoint returns to its current log-only response."
  },
