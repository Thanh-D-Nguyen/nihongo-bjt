  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "PostgreSQL tests prove learner GET /api/flashcards/styles returns active Admin-managed rows, GET /active returns the selected canonical style config, PUT /active persists/reset preferences and rejects inactive/missing styles without mutation; visible learner flashcard style picker consumes the real contracts and persistence survives refresh."
      }
    ],
    "expected_behavior": "Learner list, active-style lookup and selection use the canonical learning.flashcard_style table and profile preference, preserve JSON/API contracts, and persist only active valid selections.",
    "observed_behavior": "Admin styles persist in learning.flashcard_style, but the learner style store reads content.flashcard_style; the learner list and active-style APIs cannot consume Admin-managed styles.",
    "rollback_plan": "Revert only the AUDIT-128 Go store/handler, test, and component regression changes; no schema migration or canonical content mutation is involved. Test fixtures are isolated by generated IDs and cleaned up after each test/browser run."
  },
