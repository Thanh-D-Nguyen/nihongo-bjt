  "spec": {
    "problem": "Flashcard summary KPIs expose missing values as available and map duration availability to the wrong KPI.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Flashcard retentionRate is computed from real rating events, averageDurationMs uses elapsed_ms, and empty retention/duration/newCardsLearned metrics are explicitly unavailable with no values."
      }
    ],
    "expected_behavior": "Persisted review ratings produce real retention and duration KPIs; empty/unsupported flashcard metrics have available=false with no fabricated value.",
    "observed_behavior": "Visible flashcard export showed retention and duration values omitted while available=true; handler hardcodes empty duration to KPI 4 despite its configured duration index 3.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "DOMAIN_LOGIC",
      "API_CONTRACT"
    ],
    "change_kind": "bugfix",
    "rationale": "Derive flashcard retention and duration from real review events and report no-data availability accurately."
  },
