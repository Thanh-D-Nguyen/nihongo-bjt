  "spec": {
    "problem": "GET /api/analytics/heatmap is session guarded but reads study data using caller-controlled userId query input. The active LearningHeatmap component expects a different response DTO, so the result can fail on data.days access.",
    "acceptance": [
      {
        "id": "identity",
        "text": "Heatmap data is scoped to the validated learner session regardless of userId query input."
      },
      {
        "id": "anonymous",
        "text": "Unauthenticated heatmap requests return 401."
      },
      {
        "id": "frontend_contract",
        "text": "GET /api/analytics/heatmap returns the LearningHeatmap DTO shape and the learner screen renders without a page error."
      }
    ],
    "expected_behavior": "Authenticated learner receives only their own heatmap aggregates; userId query input cannot select another learner.",
    "observed_behavior": "Handler currently queries the supplied userId despite LearnerGuard installing the authenticated identity.",
    "rollback_plan": "Revert the handler change and regression test together while retaining the learner route guard."
  },
  "classification": {
    "classes": [
      "DOMAIN_LOGIC",
      "AUTH_SECURITY",
