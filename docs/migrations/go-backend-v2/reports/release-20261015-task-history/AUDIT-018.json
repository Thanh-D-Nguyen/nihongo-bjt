  "spec": {
    "problem": "Admin duplicate creates only the exam header, silently dropping child sections, questions, and options.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "PostgreSQL integration test proves an Admin duplicate copies two ordered sections, question rows, and options while preserving correctness flags and producing a draft with a new slug/IDs."
      },
      {
        "id": "AC2",
        "text": "Mutating mock-exam routes require admin.content.write; anonymous calls return 401, authenticated Admin without permission gets 403, and an authorized Admin receives the copied contract."
      }
    ],
    "expected_behavior": "Duplicate atomically into a draft with copied sections, questions, and answer options using new IDs and preserved order/content; preserve the source and return the copied detail.",
    "observed_behavior": "The visible authenticated Admin API response for the duplicated official exam had sections:[] while the source had nine persisted sections; the handler only inserted bjt_mock_test.",
    "rollback_plan": "Revert the handler and regression test; no canonical authored exam data is modified."
  },
