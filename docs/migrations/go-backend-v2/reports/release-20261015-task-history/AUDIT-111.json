  },
  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "A learner with an active subscription gets source 'subscription' with its plan slug, localized plan names from plan config, status, currentPeriodEnd, cancelAtPeriodEnd, entitlement keys and quota rows."
      },
      {
        "id": "AC2",
        "text": "A learner without a subscription gets source 'default' with the free plan."
      },
      {
        "id": "AC3",
        "text": "The existing subscription and pendingSubscription fields keep their current values."
      },
      {
        "id": "AC4",
        "text": "The settings/subscription page renders the plan with no error boundary at 390x844 in visible Chrome."
      }
    ],
    "expected_behavior": "The response also includes the SubscriptionData fields (planSlug, planName, planNameVi, planNameJa, source, status, currentPeriodEnd, cancelAtPeriodEnd, entitlements, quotas) while keeping subscription and pendingSubscription unchanged.",
    "observed_behavior": "GET /api/learner/monetization/subscription returns only subscription and pendingSubscription; the settings/subscription page reads planSlug, planName, source, entitlements and quotas, so it crashes with 'Cannot read properties of undefined (reading length)' and shows the error page.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DOMAIN_LOGIC"
    ],
    "change_kind": "bugfix",
    "rationale": ""
  },
  "red_exception": null,
