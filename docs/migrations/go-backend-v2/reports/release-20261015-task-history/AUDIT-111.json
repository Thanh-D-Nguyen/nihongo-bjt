  "title": "Learner subscription summary fields for the settings page",
  "start_head": "24030f8a173fe7f2b9e5c6e8af071bff8ee2bd43",
  "preexisting_changes": {
    "apps/admin/tsconfig.tsbuildinfo": "1ebcbc1e512aaf84682dc85cbd10250c8d5ad6e3",
