  "spec": {
    "problem": "Four Admin DLQ detail and mutation routes must enforce their permission and input contracts, report DB failures accurately, atomically audit mutations, and retry only through a real idempotent processing path.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Test each of the four METHOD+PATH through real router middleware with PostgreSQL fixtures, covering auth/permission/CSRF, validation, persistence/audit, and retry delivery/idempotency."
      },
      {
        "id": "AC2",
        "text": "Fix locally reproducible defects with a scoped production diff and leave unrelated working-tree changes untouched."
      }
    ],
    "expected_behavior": "Only authorized admins can access these routes; request validation and status transitions are explicit; detail matches the Admin caller DTO; database and audit failures never become false success/404; each retry changes durable state and audit at most once while already-open retry requests are idempotent; bulk mutations are all-or-nothing.",
    "observed_behavior": "These AdminGuard-only routes lacked handler-level permission checks; detail audit JSON disagreed with the live Admin DTO; malformed IDs and database/audit failures were misreported or swallowed; repeated retries incremented retry_count and audit rows repeatedly; resolve/retry/bulk mutations were not atomic with their audit records.",
    "rollback_plan": "Revert only the Wave 4 edits in the dead-letter handlers and remove the focused Wave 4 test file; preserve every pre-existing and concurrent change in the shared worktree."
  },
