  "id": "AUDIT-114",
  "title": "Port privacy-filtered public profile API",
  "start_head": "2e1ff535f0365d865a1853dcb3286d34cbf3b317",
  "preexisting_changes": {},
  "spec": {
    "problem": "Public learner profile pages currently fail because the Go API does not expose the compatibility profile GET endpoint.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Valid active UUID: return typed profile fields and presence; return profile aggregate only when privacy allows; support self/friend/stranger/blocked and anonymous identity; invalid UUID is 400, missing/inactive user is 404; DB/session lookup failures fail closed; integration proves sensitive fields never leak; UI caller renders actual response."
      }
    ],
    "expected_behavior": "Return the legacy PublicProfileData shape with optional identity, privacy-filtered aggregate stats and achievements, relationship, and Redis presence; never serialize private auth fields.",
    "observed_behavior": "GET /api/users/{userId}/profile is absent from the Go router; the existing /u/[userId] page receives 404.",
    "rollback_plan": "Remove the new route, handler, DTO and store query; no schema or data migrations are needed."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "AUTH_SECURITY",
      "DATABASE"
    ],
    "change_kind": "bugfix",
    "rationale": "Restore a missing public profile contract using existing PostgreSQL/Redis schema while preserving privacy boundaries."
  },
