  "spec": {
    "problem": "Support Notes API uses a nonexistent relation although the UI contract is an audit-log projection; current routes lack server-side support permissions.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Admin support notes use a canonical PostgreSQL model and migration; authorized reads honor privacy scope and write read/create audit events; authorized UI create/list persists; unauthorized roles are rejected."
      }
    ],
    "expected_behavior": "Read and create support-note events in ops.admin_audit_log, return the existing UI DTO, enforce support read/write permissions and visibility scopes server-side, and audit reads plus writes. Integration tests and visible Admin UI pass.",
    "observed_behavior": "GET /api/admin/support/notes returns 500/42P01; frontend expects action/reason/targetId/before/after/actor DTO backed by operator audit events.",
    "rollback_plan": "Revert only the support-note handler, route middleware, and regression test changes; delete only disposable test actors/users/audit events created for verification."
  },
