  "spec": {
    "problem": "Learner AnnouncementStrip always receives an empty list because GET /api/announcements is a static stub, so active announcements stored by Admin never appear.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET /api/announcements returns active persisted announcement rows using the AnnouncementStrip JSON fields."
      },
      {
        "id": "AC2",
        "text": "Inactive, future, and expired announcements are excluded; no results is JSON []."
      },
      {
        "id": "AC3",
        "text": "Database query failures return HTTP 500 rather than falsely returning an empty list."
      },
      {
        "id": "AC4",
        "text": "Public route remains anonymous and ordered deterministically by priority, sortOrder, then creation time."
      }
    ],
    "expected_behavior": "The public endpoint returns persisted active announcements in the frontend contract and hides inactive or not-yet-started/expired items.",
    "observed_behavior": "The Go handler returns [] for every request, ignoring content.announcement.",
    "rollback_plan": "Revert the handler and its focused regression test; prior stub behavior returns."
  },
