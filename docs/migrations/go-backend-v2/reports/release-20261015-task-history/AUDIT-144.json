{
  "schema": "nihongo-task/1",
  "id": "AUDIT-144",
  "title": "Secure Admin pet and streak APIs",
  "start_head": "a2f2a6e31868f4bd7a5c4d2cef7e728049dbfe99",
  "preexisting_changes": {},
  "spec": {
    "problem": "Five active Admin pet/streak APIs have incomplete authorization, database error contracts, validation, and persistence/audit semantics.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET pet stats returns accurate aggregate contract and surfaces DB/row errors; anonymous and roleless Admin are denied."
      },
      {
        "id": "AC2",
        "text": "GET pet detail distinguishes missing id (404) from database failure (500), enforces read permission, and exposes only the existing detail contract."
      },
      {
        "id": "AC3",
        "text": "PUT pet update validates all supplied fields, reports missing row as 404, records audit atomically, and denies roleless/read-only/untrusted-origin requests."
      },
      {
        "id": "AC4",
        "text": "POST pet reset checks row existence, records actor audit atomically, returns accurate errors, and denies roleless/read-only/untrusted-origin requests."
      },
      {
        "id": "AC5",
        "text": "GET streak configs enforces admin.content.read and surfaces scan/iteration errors."
      }
    ],
    "expected_behavior": "Each of the five METHOD+PATH APIs enforces its required RBAC/CSRF, returns accurate 4xx/5xx contracts, validates inputs, and returns consistent persisted state; reset/update audit mutations atomically; integration tests cover unauthorized, invalid, missing, database-failure, and persistence cases; headed 390x844 UI remains functional.",
    "observed_behavior": "Pet statistics ignores count, aggregate, query and row scan errors; pet detail converts all DB errors to 404; pet updates silently ignore invalid fields and don't check missing rows; reset reports success without checking affected rows; the streak list ignores scan failures. Routes need explicit content permissions and CSRF on writes.",
    "rollback_plan": "Revert the isolated AUDIT-144 code commit. No schema migration is expected; pet updates/resets use disposable local pet rows and cleanup; streak config is read-only in this wave."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "AUTH_SECURITY",
      "DATABASE"
    ],
    "change_kind": "bugfix",
    "rationale": "Repair existing Admin gamification API authorization and response/persistence contracts without changing schemas."
  },
