  "spec": {
    "problem": "Roleless Admin sessions without iam.manage or support.user.read can load Battle Abuse reports.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous list request returns 401."
      },
      {
        "id": "AC2",
        "text": "Roleless Admin list request returns 403 without report data."
      },
      {
        "id": "AC3",
        "text": "Admin with iam.manage can read paginated list contract."
      },
      {
        "id": "AC4",
        "text": "Admin with support.user.read can read paginated list contract."
      }
    ],
    "expected_behavior": "Require iam.manage or support.user.read on abuse report read routes, matching the Admin navigation; preserve the paginated list DTO.",
    "observed_behavior": "Visible roleless Admin (permissions=[]) currently loads /admin/vi/battle/abuse and GET /api/admin/battle/abuse returns 200; anonymous receives 401.",
    "rollback_plan": "Revert only the battle abuse read-route permission middleware and the new regression test."
  },
  "classification": {
    "classes": [
      "AUTH_SECURITY",
      "API_CONTRACT"
