{
  "schema": "nihongo-task/1",
  "id": "AUDIT-084",
  "title": "Audit learner magazine index screen",
  "start_head": "a127559cc5c4a4dddb0c444ec635525446f56bcd",
  "preexisting_changes": {},
  "spec": {
    "problem": "The learner magazine index reports no articles despite published local content because it expects an envelope and fields the API does not return; filters and pagination also do not reach the Go list query, and fetch failures are rendered as an empty state.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Through the visible learner browser at 390x844, verify the published list renders cards and metadata in vi/en/ja, category filters and pagination preserve the selected state, the empty result is distinct from an upstream failure, and article links navigate to detail."
      },
      {
        "id": "AC2",
        "text": "GET /api/magazine supports paged/filter queries and returns {data,total,page,limit} with publishDate, summaryVi, and ordered vocabWords; only published rows appear, mobile's MagazineDto accepts the envelope, and operational database errors are not returned as an empty catalog."
      },
      {
        "id": "AC3",
        "text": "For published catalogs, page values beyond the last result page clamp to the final non-empty page; web renders the returned page rather than a false empty state."
      }
    ],
    "expected_behavior": "GET /api/magazine returns a stable paged envelope of published articles with the fields used by web and mobile, applies equivalent kind/widgetKind filters plus page/limit, and reports database/row errors as 5xx. The localized learner index distinguishes operational failures from a genuinely empty result and renders real cards, date, vocabulary preview, filters, and pagination without breaking the mobile DTO.",
    "observed_behavior": "At /vi/magazine on a 390x844 visible browser, the shell and filters render but the empty state appears. The Go GET /api/magazine returns a bare array of reduced records, while the page expects {data,total,page,limit}, publishDate, summaryVi, and vocabWords. Web sends kind/page/limit; Go only reads widgetKind and hardcodes 20. Network/5xx failures are caught and treated as an empty catalog. Mobile's DTO accepts either a bare list or the paged envelope.",
    "rollback_plan": "Revert the list response/query change, localized magazine error state, and their tests together; the mobile DTO supports both the prior bare array and the paged envelope, so rolling back the API and web consumer together restores the old contract. No master vocabulary or database schema changes are required."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DOMAIN_LOGIC",
      "UI_ONLY"
    ],
    "change_kind": "bugfix",
    "rationale": "The web magazine index contract never matched the published list route, and list filters/pagination have been ignored since the API was built. Restore an explicit compatible paged list contract, distinguish failure from no published results, and pin cross-client behavior with route and page tests."
  },
  "red_exception": null,
