  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Opening /vi/account follows the documented redirect chain and never exposes another learner’s data."
      },
      {
        "id": "AC2",
        "text": "Anonymous behavior is intentional and localized; protected learner data is not returned to the browser."
      },
      {
        "id": "AC3",
        "text": "A real authenticated learner sees their persisted identity/account content through the target screen."
      },
      {
        "id": "AC4",
        "text": "Refresh and 390px mobile layout preserve the expected route and keep controls reachable."
      },
      {
        "id": "AC5",
        "text": "AC1: /vi/account follows settings then /me?tab=settings without exposing another account."
      },
      {
        "id": "AC6",
        "text": "AC2: Anonymous users are redirected to localized login; no protected account content is exposed."
      },
      {
        "id": "AC7",
        "text": "AC3: An authenticated learner sees persisted account settings data via the alias."
      },
      {
        "id": "AC8",
        "text": "AC4: Refresh preserves the account route and settings; at 390px every tab control stays within viewport."
      }
    ],
    "expected_behavior": "Anonymous /vi/account redirects to localized login through /settings and /me?tab=settings with GET /api/auth/me returning 401 and no protected data. Authenticated learner sees persisted settings through the alias after refresh. At 390px, all four tabs remain visible and within the content width.",
    "observed_behavior": "Visible localhost browser: clean isolated context redirected to login; authenticated real learner session showed account identity and remained after refresh. Mobile emulation first showed the final tab ending at x=411.93; after the responsive grid fix, all four tab bounds fit x=32..358 with document width 390. Anonymous Playwright smoke, focused regression test, frontend quality gate, and typecheck passed.",
    "rollback_plan": ""
  },
