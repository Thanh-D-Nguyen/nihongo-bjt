  "spec": {
    "problem": "Audit the protected learner achievements screen and verify its read-only catalog-driven gamification UI.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous visit to /vi/achievements is redirected to localized login and does not expose protected gamification data."
      },
      {
        "id": "AC2",
        "text": "Authenticated learner can open the alias and view persisted achievement progress, streaks, and leaderboards without changing canonical vocabulary, kanji, or grammar datasets."
      },
      {
        "id": "AC3",
        "text": "Achievement, streak, and leaderboard tabs and category filters respond correctly; browser errors and failed requests are recorded and resolved or explained."
      },
      {
        "id": "AC4",
        "text": "At 390x844 the achievements screen and all primary controls remain visible, reachable, and free from horizontal overflow; refresh keeps the selected route/tab behavior."
      }
    ],
    "expected_behavior": "Alias redirects into protected profile achievements. Authenticated learner data loads into achievement, streak, and leaderboard views; canonical learning catalogs remain unmodified.",
    "observed_behavior": "Visible browser: anonymous /vi/achievements reaches localized login and GET /api/auth/me returns 401. Authenticated learner reaches /vi/me?tab=achievements; streaks, achievement browse/pending, and leaderboard requests return successful empty/catalog responses as appropriate. A disposable streak row rendered its 3-day current streak, 5-day record, and one remaining freeze in the UI; the row and config were deleted and verified absent. Streak and leaderboard tabs worked, empty states were localized, and 390x844 document width stayed 390. PostgreSQL integration test reproduced the stale columns before the fix and passed GET plus activity persistence against the canonical schema after the fix. Vocabulary, kanji, and grammar catalogs were not modified.",
    "rollback_plan": "Revert only the AUDIT-058 changes to the gamification streak SQL, achievements client response mapping, and its integration regression test; leave all pre-existing workspace changes intact."
  },
  "classification": {
    "classes": [
      "UI_ONLY",
      "DATABASE",
      "CI_QUALITY_SYSTEM"
    ],
