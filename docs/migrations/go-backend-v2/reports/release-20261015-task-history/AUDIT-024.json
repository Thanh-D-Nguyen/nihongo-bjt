  "spec": {
    "problem": "POST /api/ads/click returns success but drops every valid event. Its mounted handler is a logger-only stub; another unmounted handler writes to the obsolete ads.click relation.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "An anonymous AdSlot click is recorded in monetization.ad_impression with canonical placement/campaign/decision fields; invalid requests are rejected and infrastructure errors do not return success."
      }
    ],
    "expected_behavior": "Validate an active canonical placement, safely persist a click as a monetization.ad_impression event using the existing schema, preserve the endpoint's 204 contract, and return useful 4xx/5xx errors. Integration test proves persistence and invalid-input behavior; visible UI caller and anonymous response pass.",
    "observed_behavior": "Visible AdSlot calls /api/ads/click with placementCode, campaignId, decisionKey, clientContext and decisionToken. Mounted route returns 204 without persistence; Admin ads analytics counts monetization.ad_impression kind=click.",
    "rollback_plan": "Revert only the ads click route/handler and regression-test changes; delete only disposable test placement and click rows created by verification."
  },
