  "spec": {
    "problem": "A real learner UI dismissal returns {persisted:false} and creates no announcement_dismissal row because a static guest stub is registered before the database-backed handler.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Authenticated visible UI dismiss sends POST 200 {dismissed:true,persisted:true} and persists one row for that learner/announcement."
      },
      {
        "id": "AC2",
        "text": "Repeated authenticated dismissal is idempotent and leaves one row."
      },
      {
        "id": "AC3",
        "text": "Anonymous valid dismissal returns {dismissed:true,persisted:false} and creates no row."
      },
      {
        "id": "AC4",
        "text": "Database write errors return HTTP 500 rather than success; CSRF and optional-auth behavior stay in place."
      }
    ],
    "expected_behavior": "The optional-auth route resolves a valid learner session, CSRF remains enforced, and a valid dismissal is persisted idempotently; anonymous users remain locally dismissible without persistence.",
    "observed_behavior": "The visible authenticated learner clicked the real dismissal button; POST 200 returned persisted:false and PostgreSQL had no row for that user.",
    "rollback_plan": "Restore the previous announcement route registration and handlers; this returns to the verified pre-task behavior."
  },
