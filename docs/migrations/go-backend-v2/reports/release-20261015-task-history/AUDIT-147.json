  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "AC1: the session gate sends returnTo=/admin/<locale>/... (the full Admin path including the basePath) on 401 redirects."
      },
      {
        "id": "AC2",
        "text": "AC2: the login page's existing returnTo validation is unchanged and still rejects external or traversal values."
      },
      {
        "id": "AC3",
        "text": "AC3: a headed browser login from an anonymous deep link to /admin/vi/growth/campaigns returns to /admin/vi/growth/campaigns with no console errors."
      }
    ],
    "expected_behavior": "A protected Admin route redirected to login carries a returnTo that includes /admin, so after sign-in the browser returns to the same Admin route.",
    "observed_behavior": "Admin session gate builds returnTo from the locale-relative pathname without the /admin basePath (apps/admin/app/_components/admin-session-gate.tsx). The login form then calls window.location.assign(returnTo), so a deep link to /admin/vi/growth/campaigns lands on /vi/growth/campaigns, which Caddy routes to the learner app.",
    "rollback_plan": ""
  },
