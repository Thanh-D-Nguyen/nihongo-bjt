{
  "schema": "nihongo-task/1",
  "id": "AUDIT-115",
  "title": "Hide expired subscriptions from learner summary",
  "start_head": "7ed3ae0a29661710ea0a6be580a12387a89a56f6",
  "preexisting_changes": {},
  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "A PostgreSQL-backed regression creates a cancelled-at-period-end subscription with a past current_period_end and proves it is absent from the summary; a future/current period remains summarized; visible learner subscription screen reflects expired state."
      },
      {
        "id": "AC2",
        "text": "The subscription object, plan summary, entitlements, and quotas use the same eligibility rules as official quiz access (active plan; started period; unexpired current period; trial_end valid when trialing); regression fixtures cover period-start, period-end, expired-trial, and inactive-plan cases."
      }
    ],
    "expected_behavior": "Only subscriptions attached to an active plan and within their current period are shown as current: period start has passed, period end is null or future, and a trial has not ended. Expired or otherwise ineligible rows produce the Free summary and subscription:null.",
    "observed_behavior": "GET /api/learner/monetization/subscription continues to report plan entitlements after current_period_end has passed, even though quiz access correctly checks period expiry.",
    "rollback_plan": "Revert the activeQ current_period_end predicate to restore the previous plan summary behavior; no schema or data migration is involved."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DATABASE",
      "AUTH_SECURITY"
    ],
    "change_kind": "bugfix",
    "rationale": ""
  },
