{
  "schema": "nihongo-task/1",
  "id": "AUDIT-134",
  "title": "Enforce RBAC on Admin retention API and screen",
  "start_head": "05ac22e9131bc5b1257c81f257071f593267150b",
  "preexisting_changes": {},
  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Add a real-router PostgreSQL integration regression for anonymous 401, roleless 403, admin.legal.read 200 with all retention fields and seven unique domains, and iam.manage-only 200. Record RED before enforcing RequireAnyPermission for OpenAPI legal grants plus iam.manage and align OpenAPI. Rebuild/stabilize canonical local runtime; use visible Admin login form for anonymous/roleless/authorized 390x844 screen and API validation; run Go suite and independent AUTH_SECURITY review; update inventories and commit screen/API together."
      }
    ],
    "expected_behavior": "Anonymous remains 401, authenticated Admin without permission gets 403, and Admin with admin.legal.read or iam.manage gets 200 with all seven documented retention domains and fields.",
    "observed_behavior": "GET /api/admin/legal/retention is behind AdminGuard only even though OpenAPI requires admin.legal.read/admin.legal.write/legal.admin and the Admin retention page/nav is restricted to iam.manage.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "AUTH_SECURITY"
    ],
    "change_kind": "bugfix",
    "rationale": "This enforces the missing backend role permission on a privacy/legal retention API and aligns its documented permission contract."
  },
