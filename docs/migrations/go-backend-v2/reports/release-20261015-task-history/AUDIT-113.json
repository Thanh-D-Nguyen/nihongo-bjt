  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "An active subscription stays status 'active' with cancel_at_period_end true after POST cancel, and the response is {ok:true,cancelAtPeriodEnd:true}."
      },
      {
        "id": "AC2",
        "text": "POST cancel with no active or trialing subscription returns 404; anonymous returns 401; an untrusted origin returns 403."
      },
      {
        "id": "AC3",
        "text": "The subscription summary then reports cancelAtPeriodEnd true for that learner."
      }
    ],
    "expected_behavior": "The endpoint sets cancel_at_period_end = true, keeps the subscription active until period end, returns {ok:true, cancelAtPeriodEnd:true}; with no active subscription it returns 404.",
    "observed_behavior": "POST /api/learner/monetization/subscription/cancel sets the subscription status to 'cancelled' immediately and returns {cancelled:true}; the settings page expects cancel-at-period-end (it keeps the plan and sets cancelAtPeriodEnd), so the learner loses paid access before the period ends.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "DOMAIN_LOGIC",
      "API_CONTRACT",
      "AUTH_SECURITY"
    ],
    "change_kind": "bugfix",
    "rationale": ""
  },
