  "title": "Learner subscription cancel: cancel at period end instead of cutting access",
  "start_head": "1efbd6f4d7e61e62566210cf22169a5177f9e66d",
  "preexisting_changes": {
    "apps/admin/next-env.d.ts": "9edff1c7cacb3bfac9a1eadcf6f51eaa99565e38",
