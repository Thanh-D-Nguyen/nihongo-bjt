{
  "schema": "nihongo-task/1",
  "id": "AUDIT-132",
  "title": "Enforce Admin RBAC on legal cookie categories API",
  "start_head": "ff8a058bde02d2f255060b3714d55a9d7e88a0e9",
  "preexisting_changes": {},
  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous GET is 401; authenticated Admin with canonical legal-read permission gets exact four-category contract and status 200; session without permission is 403; visible Admin caller and same-origin request verified; regression test goes RED before route-level RBAC fix, then green and required security review."
      },
      {
        "id": "AC2",
        "text": "Add a real-router PostgreSQL integration regression that checks anonymous 401, roleless Admin 403, and iam.manage Admin 200 with exactly four unique category keys, total, partialSchemaPending, and required fields; record RED before implementation. Add RequirePermission(iam.manage) to GET /api/admin/legal/cookie-categories only. Rebuild runtime, check API via visible Admin UI/session and anonymous/roleless behavior, run Go suite, obtain independent AUTH_SECURITY APPROVE, update durable audit inventories, and commit."
      }
    ],
    "expected_behavior": "Anonymous remains 401, authenticated Admin without iam.manage receives 403, and an Admin with iam.manage receives HTTP 200 and the documented four-category JSON contract.",
    "observed_behavior": "GET /api/admin/legal/cookie-categories sits behind AdminGuard but has no route-level permission middleware. Frontend nav hides Legal Cookies unless iam.manage is present; docs/OpenAPI classify it as an Admin permissioned route.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "AUTH_SECURITY"
    ],
    "change_kind": "bugfix",
    "rationale": "This fixes a verified missing backend authorization check on an Admin legal API, using the project's canonical permission guard."
  },
  "red_exception": null,
  "red_targets": [
    {
      "runner": "go",
      "package": "./internal/httpserver",
      "test": "TestAdminLegalCookieCategoriesRequiresIManage",
      "expect": "expected roleless Admin to return 403, got 200"
    }
  ],
