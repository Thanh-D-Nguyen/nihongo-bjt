  "id": "AUDIT-110",
  "title": "Fix notification preferences save for learners without a preferences row",
  "start_head": "8d8b2412d7a3480dca3e0bdfcef840d041d34f59",
  "preexisting_changes": {
    "apps/admin/next-env.d.ts": "9edff1c7cacb3bfac9a1eadcf6f51eaa99565e38",
