  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "PUT /api/learner/notification-preferences by a learner with no row returns 200 and the echoed preferences."
      },
      {
        "id": "AC2",
        "text": "The row is persisted with non-null updated_at; a second PUT updates the same row and advances updated_at."
      },
      {
        "id": "AC3",
        "text": "GET after PUT returns the saved values."
      }
    ],
    "expected_behavior": "PUT returns 200 with the saved preferences, creates the row with created_at/updated_at set, and a subsequent GET returns the saved values.",
    "observed_behavior": "PUT /api/learner/notification-preferences returns 500 for a learner who has no notification_preference row (INSERT leaves NOT NULL updated_at unset); the settings page shows 'Không tải hoặc lưu được' and nothing is saved.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DOMAIN_LOGIC",
      "CI_QUALITY_SYSTEM"
    ],
    "change_kind": "bugfix",
    "rationale": ""
  },
