  "spec": {
    "problem": "Admin analytics refresh reports accepted even when the refresh request cannot be persisted.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "POST /api/admin/analytics/{domain}/refresh persists an accepted analytics.rollup_run record containing the domain, requesting Admin, and reason; returns that persisted runId, and fails explicitly if persistence fails."
      }
    ],
    "expected_behavior": "Every accepted refresh request is stored in the canonical analytics.rollup_run table with domain, requester and reason, and the response exposes its persisted run id; database failures return an error.",
    "observed_behavior": "The handler inserts into a nonexistent analytics.analytics_rollup_run relation and ignores the resulting error, still returning HTTP 202.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DATABASE"
    ],
    "change_kind": "bugfix",
    "rationale": "Correct analytics rollup persistence to match the canonical Prisma schema and surface failed writes."
  },
