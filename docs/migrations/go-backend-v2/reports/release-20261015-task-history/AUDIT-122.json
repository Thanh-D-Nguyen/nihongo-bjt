    }
  ],
  "sensitivity": null,
  "deletion": null,
  "risk_acknowledgements": [
    {
      "finding": "baseline_expanded:apps/api-go/internal/postgres/testdata/sql_conformance_baseline.json:min_statements_checked_lowered",
      "reason": "The audit confirmed two daily-radar publish SQL failures against the canonical Prisma schema (ambiguous status from the unnecessary join and nonexistent published_at). The fixed query removes those two inspected SQL statements, so the generated baseline floor reflects the actual 1155 statements checked after the code change; no unrelated debt was deleted and the canonical conformance test passes."
    }
  ],
