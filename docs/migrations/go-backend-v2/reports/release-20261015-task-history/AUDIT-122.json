{
  "schema": "nihongo-task/1",
  "id": "AUDIT-122",
  "title": "Audit Daily Radar publish and module endpoints",
  "start_head": "16234213e3ec09699c6f684984353e64811772c7",
  "preexisting_changes": {},
  "spec": {
    "problem": "Three pending Admin Daily Radar APIs need individual verification. Card publish is missing admin.content.write and CSRF middleware and its status update/audit writes are not atomic. Module detail must return its persisted API contract and correct missing-record response. Module archive uses the required write guard but ignores audit errors after mutating the module, which can leave an unaudited state change.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "POST /api/admin/daily-radar/cards/{id}/publish rejects roleless Admin and untrusted Origin without mutation; authorized writer gets 200 with persisted published status/updated_at and exactly one audit event; missing card returns 404."
      },
      {
        "id": "AC2",
        "text": "GET /api/admin/daily-radar/modules/{id} returns the persisted detail fields and timestamps for an existing module, and 404 for a missing module; anonymous access is rejected by AdminGuard."
      },
      {
        "id": "AC3",
        "text": "POST /api/admin/daily-radar/modules/{id}/archive persists archived status and exactly one audit row; if audit insertion fails, return 500 and leave module unchanged; missing module returns 404."
      }
    ],
    "expected_behavior": "Audit each METHOD+PATH independently with a real Admin browser session and isolated PostgreSQL fixtures. Publish and archive must not commit state without their audit record; writes require backend RBAC and trusted-origin CSRF. Persist only fields present in the canonical Prisma schema.",
    "observed_behavior": "Card publish has no content-write or CSRF route middleware, updates a nonexistent published_at column, and uses independent update/audit calls. Module archive uses independent update/audit calls and discards audit errors. Module detail has not been validated against a persisted fixture/contract.",
    "rollback_plan": "Revert only AUDIT-122 handler/router/test changes and its audit checkpoint; all database fixtures are disposable and cleaned in test/visible-browser scripts."
  },
  "classification": {
    "classes": [
      "AUTH_SECURITY",
      "API_CONTRACT",
      "DATABASE",
      "CI_QUALITY_SYSTEM"
    ],
    "change_kind": "bugfix",
    "rationale": "Protect the publishing route and make Daily Radar status transitions atomic with audit. Shrink only the canonical SQL drift signature proven resolved by the publish handler change."
  },
  "red_exception": null,
  "red_targets": [
    {
      "runner": "go",
      "package": "./internal/httpserver",
      "test": "TestAdminDailyRadarCardPublishRequiresContentWrite",
      "expect": "roleless publish status="
    },
    {
