{
  "schema": "nihongo-task/1",
  "id": "AUDIT-141",
  "title": "Secure and repair five Admin flashcard variant APIs",
  "start_head": "3c138db3d83db24fa62cad611868b1d63c1990e1",
  "preexisting_changes": {},
  "spec": {
    "problem": "Five active Admin Flashcard variant endpoints need individual API verification and repair; current source shows they bypass route-level permissions/CSRF and responses do not satisfy the actual detail editor.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET /api/admin/flashcards/variants individually verifies anonymous 401, roleless/read permission behavior, filters/pagination, response fields, and database error handling."
      },
      {
        "id": "AC2",
        "text": "GET /api/admin/flashcards/variants/{id} individually verifies authorization, not-found behavior, canonical and audit contract, and arrays required by the drawer."
      },
      {
        "id": "AC3",
        "text": "PATCH /api/admin/flashcards/variants/{id} verifies permission/CSRF, input validation, persistence, actor audit atomicity, and the client displays refreshed detail."
      },
      {
        "id": "AC4",
        "text": "PATCH /api/admin/flashcards/variants/{id}/source verifies permission/CSRF, supported active source, invalid/missing rows, persistence, audit atomicity, and refreshed detail."
      },
      {
        "id": "AC5",
        "text": "POST /api/admin/flashcards/variants/{id}/transition verifies permission/CSRF, allowed status transitions, persistence, audit atomicity, and refreshed detail."
      },
      {
        "id": "AC6",
        "text": "Visible headed 390x844 Admin browser uses real UI/session, loads detail without page errors, exercises each practical action and observes all five API requests and resulting persisted state."
      },
      {
        "id": "AC7",
        "text": "All fixtures are disposable and removed; canonical authored content remains untouched; update the five inventory verdicts/checkpoint and commit this five-API wave."
      }
    ],
    "expected_behavior": "All five methods enforce server-side read/write permissions and trusted-Origin CSRF, return the contract consumed by the real UI, validate and persist safely with actor-attributed audit transactions, and expose database failures instead of false success.",
    "observed_behavior": "The five routes are registered directly under AdminGuard without admin.content.read/write middleware or CSRF on mutations. List/detail mask SQL errors; detail omits arrays accessed by the drawer; mutation responses are partial though the client casts them to Detail; writes can succeed without durable atomic audit.",
    "rollback_plan": "Revert the AUDIT-141 handler/client/test/report changes; changes are scoped to flashcard variants and disposable fixtures only."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "AUTH_SECURITY",
      "DATABASE",
      "UI_ONLY"
    ],
    "change_kind": "bugfix",
    "rationale": "Repair five registered Admin flashcard-variant API contracts, enforce route-level permissions and CSRF, preserve real PostgreSQL/audit guarantees, and align the existing Admin detail workflow."
  },
  "red_exception": null,
