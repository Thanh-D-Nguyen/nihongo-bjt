  "spec": {
    "problem": "Mock exam detail hid a missing SQL relation and returned an empty section list.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET /api/admin/assessment/mock-exams/{id} returns every persisted bjt_test_section ordered by display_order for a seeded canonical mock exam, with question counts from assessment.bjt_question."
      },
      {
        "id": "AC2",
        "text": "A section-query failure returns a visible server error instead of a successful response containing an empty sections list."
      }
    ],
    "expected_behavior": "Detail returns persisted test sections in display order with question counts from the canonical bjt_question table, and database errors return 500.",
    "observed_behavior": "Visible GET detail returned sections=[] while the same exam list reported sectionCount=9; the SQL conformance baseline also contained now-fixed nonexistent-table references.",
    "rollback_plan": "Revert the section query/error-handling change and matching SQL conformance baseline update; no schema migration or persistent data changes are required."
  },
