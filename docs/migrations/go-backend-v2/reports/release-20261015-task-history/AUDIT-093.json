  "schema": "nihongo-task/1",
  "id": "AUDIT-093",
  "title": "Audit learner Quiz print screen",
  "start_head": "10481cb53a4d2bb1cb7ab825e7a8e93587a7b817",
  "preexisting_changes": {},
  "spec": {
    "problem": "Quiz print route cannot render the published practice exam because its browser fetch bypasses the configured proxy and its assumed DTO disagrees with the authoritative Go response.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Add a valid regression test that fails against current route/DTO contract; fix the shared contract/path at the authoritative boundary; verify Go integration and frontend tests/typecheck/build; visibly inspect Vietnamese and Japanese route at desktop and 390x844, observe real API request and print preview, verify official denial and invalid-ID/retry behavior; update screen inventory and commit this screen before proceeding."
      }
    ],
    "expected_behavior": "Opening a published non-official practice template through the visible Quiz UI loads the complete printable exam with localized titles, ordered sections/questions/options, timing/level metadata, and optional answer key. Official templates remain denied; loading/error states are actionable; print controls are keyboard accessible and excluded from printed output.",
    "observed_behavior": "PrintExamClient fetches NEXT_PUBLIC_API_URL/default localhost:4000 directly and casts the response to an unrelated shape; Go PrintableTemplate returns title, sections, IDs and correctAnswer. UI labels are hardcoded, and the error state has no retry.",
    "rollback_plan": "Revert only the screen/API/contract/test changes from AUDIT-093."
  },
  "classification": {
    "classes": [
      "UI_ONLY",
      "API_CONTRACT",
      "CI_QUALITY_SYSTEM"
    ],
    "change_kind": "bugfix",
    "rationale": "The Quiz print bug fix also resolves one known SQL/schema drift entry; retire only that now-fixed baseline entry so the canonical SQL conformance gate remains green without lowering its coverage floor."
  },
  "red_exception": null,
