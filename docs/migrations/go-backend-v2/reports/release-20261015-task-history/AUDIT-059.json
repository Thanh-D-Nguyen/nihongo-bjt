  "spec": {
    "problem": "Learner analytics ignores the Go API dailyStats payload and shows a false empty state for real study activity.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous analytics alias redirects to localized login without exposing learner analytics data."
      },
      {
        "id": "AC2",
        "text": "Authenticated learner sees analytics from the real Go API and can change 7/30/90-day ranges and refresh successfully."
      },
      {
        "id": "AC3",
        "text": "At 390x844 the analytics screen is reachable, readable and has no horizontal overflow; refresh preserves access."
      },
      {
        "id": "AC4",
        "text": "Record real browser/API evidence and fix locally reproducible defects with regression tests."
      },
      {
        "id": "AC5",
        "text": "The client normalizes the current dailyStats API DTO without fabricating quiz or SRS activity."
      },
      {
        "id": "AC6",
        "text": "A non-zero study stat renders charted and tabulated minutes, XP, and lessons instead of the empty state; zero stats remain empty."
      },
      {
        "id": "AC7",
        "text": "Vietnamese, English, and Japanese activity labels accurately describe the displayed metrics."
      },
      {
        "id": "AC8",
        "text": "Authenticated 7/30/90 range switching and refresh work; at 390x844 the screen has no horizontal overflow."
      },
      {
        "id": "AC9",
        "text": "Anonymous routing, authenticated UI, API response, console, and network behavior are rechecked in the visible browser."
      }
    ],
    "expected_behavior": "Authenticated learners see daily minutes, XP and lesson counts from dailyStats, with activity and charts labeled truthfully; analytics remains empty only when returned metrics contain no activity.",
    "observed_behavior": "The Go API returns dailyStats with date, minutes, xpEarned and lessonsCount. The client reads only dailyActivity (reviews, quizAnswers, quizSessionsCompleted), so it drops the real activity and reports no data.",
    "rollback_plan": "Revert the analytics client, chart, localization and focused test changes from this task; no database or canonical study-content data is modified."
  },
  "classification": {
    "classes": [
      "UI_ONLY",
      "API_CONTRACT"
    ],
    "change_kind": "bugfix",
    "rationale": ""
  },
