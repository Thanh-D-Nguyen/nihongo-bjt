  "spec": {
    "problem": "The public Daily Radar API always returns empty arrays, leaving the home Daily section blank despite PostgreSQL content tables and canonical seed data.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET /api/daily-radar/home returns enabled published modules, their published cards, category list and spotlight using the existing frontend DTO."
      },
      {
        "id": "AC2",
        "text": "Draft, disabled, future and expired content is excluded; database errors return stable JSON 5xx."
      },
      {
        "id": "AC3",
        "text": "The learner Daily route redirects to the home Daily section, which renders real seeded cards anonymously and at 390x844 without browser errors."
      },
      {
        "id": "AC4",
        "text": "No vocabulary, kanji or grammar canonical data is changed."
      }
    ],
    "expected_behavior": "The public endpoint returns enabled published modules and currently published cards from PostgreSQL in the DailyRadarHomePayload contract.",
    "observed_behavior": "GET /api/daily-radar/home returns 200 with empty modules/cards; /:locale/daily redirects to home and DailyRadarSection has no real cards.",
