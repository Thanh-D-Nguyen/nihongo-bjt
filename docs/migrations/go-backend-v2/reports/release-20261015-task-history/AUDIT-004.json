  "spec": {
    "problem": "Admin analytics endpoints are available to any active Admin session, regardless of the analytics permissions required by the frontend.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Admin executive and domain read routes require viewer.analytics, admin.analytics.view, or analytics.view; export and refresh also accept admin.analytics.manage. Analytics export summary, timeseries, and breakdown CSVs are projections of existing real data handlers; empty data stays empty/zero and invalid JSON or unsupported views return HTTP 400."
      }
    ],
    "expected_behavior": "Analytics read/export operations require an analytics reader permission; export/refresh also accept the analytics manager permission. Exports use real analytics handler values, reject invalid inputs, and emit honest empty data.",
    "observed_behavior": "The Go analytics routes use AdminGuard only and the export handler emits hardcoded placeholder CSV rows.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "AUTH_SECURITY",
      "API_CONTRACT"
    ],
    "change_kind": "bugfix",
    "rationale": "Enforce backend analytics RBAC and remove fabricated values from CSV exports."
  },
