  "spec": {
    "problem": "The linked-accounts page exposes a Google OAuth action that targets /api/auth/google/start, but Google OAuth was explicitly retired and its Go route is not registered, so the real browser action returns 404.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous access redirects to localized login without exposing identity data or requesting identities."
      },
      {
        "id": "AC2",
        "text": "Authenticated learner can view linked identities and unlinking an existing identity removes it from PostgreSQL."
      },
      {
        "id": "AC3",
        "text": "Retired Google OAuth start and link-code exchange flows are absent from the UI; localized title, subtitle and empty state describe legacy account management."
      },
      {
        "id": "AC4",
        "text": "At 390x844 the page has no horizontal overflow and unlink controls are at least 48px high."
      }
    ],
    "expected_behavior": "The page accurately reflects the retired OAuth capability while preserving authenticated viewing and unlinking of existing linked identities.",
    "observed_behavior": "Visible Google CTA navigation returned 404 page not found from the local Go API.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "UI_ONLY",
      "CI_QUALITY_SYSTEM"
