  "spec": {
    "problem": "Daily Radar UI module create sends the current module contract, but the Go handler still decodes legacy key/title; module updates also recognize only legacy field names and reference columns absent from the Prisma schema.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "POST /api/admin/daily-radar/modules accepts the existing frontend payload, persists every supported field and returns the created id."
      },
      {
        "id": "AC2",
        "text": "PATCH /api/admin/daily-radar/modules/{id} accepts editable frontend fields, persists them and writes an audit record atomically."
      },
      {
        "id": "AC3",
        "text": "The real Admin UI can create a disposable module, edit it, and archive or clean it without affecting authored content."
      },
      {
        "id": "AC4",
        "text": "Admin write permission and CSRF remain enforced; malformed or missing required fields are rejected without mutation."
      }
    ],
    "expected_behavior": "Module POST/PATCH persist the current UI contract with transactional audit entries, invalid/unauthorized writes do not mutate data, and the visible form can create and update disposable modules.",
    "observed_behavior": "Visible Admin form submission POST /api/admin/daily-radar/modules returned 400 with {\"error\":\"key and title required\"}; the frontend's module editor remained open and no row was persisted. Router registrations also lack write-permission and CSRF middleware for module mutations.",
    "rollback_plan": "Revert only the Daily Radar module handler and route/test changes; no schema migration is needed. Delete disposable module/audit fixtures through test cleanup and preserve canonical content."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
