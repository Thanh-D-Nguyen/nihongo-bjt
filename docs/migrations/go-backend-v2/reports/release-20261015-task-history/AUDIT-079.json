{
  "schema": "nihongo-task/1",
  "id": "AUDIT-079",
  "title": "Audit learner lesson detail screen",
  "start_head": "67a6fd1ebbdb21a6190d8f1373733bf898d3c183",
  "preexisting_changes": {},
  "spec": {
    "problem": "The active learner lesson detail page calls GET /api/levels/lessons/{slug}, but the Go router does not register that endpoint, so published canonical lessons render as not found; completion state is browser-local only.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "A real PostgreSQL integration test proves published lesson metadata, lessonContent, ordered active child content and previous/next links are returned; inactive/unpublished/missing links are omitted or 404 as appropriate."
      },
      {
        "id": "AC2",
        "text": "Authenticated PUT progress accepts only a boolean completed value, protects mutation with learner session and CSRF, persists idempotently per user+lesson, and GET reflects the saved state; anonymous mutation is denied."
      },
      {
        "id": "AC3",
        "text": "The lesson detail screen renders its canonical content, controls work, progress survives navigation and refresh, and mobile layout has no horizontal overflow; no vocabulary/kanji/grammar CRUD is introduced."
      },
      {
        "id": "AC4",
        "text": "Prisma schema/migration validation, Go PostgreSQL integration tests, frontend behavior tests, lifecycle gates and visible browser retest pass."
      }
    ],
    "expected_behavior": "Published lessons render the canonical lesson document and active linked vocabulary/kanji/grammar from PostgreSQL; unpublished/missing lessons return 404. Signed-in learners can complete/uncomplete idempotently and see completion restored after refresh from PostgreSQL; anonymous visitors can read lesson content and are directed to login before saving progress. Content records stay read-only.",
    "observed_behavior": "Opening /vi/levels/J1/lessons/j1-01-greetings-intro renders Không tìm thấy bài học and Network shows GET /api/levels/lessons/j1-01-greetings-intro = 404. The completion toggle reads/writes bjt_lesson_completed in localStorage.",
    "rollback_plan": "The migration is additive: revert by deploying code that no longer reads/writes bjt_lesson_progress, retain learner rows until policy-approved cleanup, then remove the table in a separate reviewed migration. Revert the lesson screen/API change by reverting its commit; canonical curriculum/content rows are never modified."
  },
