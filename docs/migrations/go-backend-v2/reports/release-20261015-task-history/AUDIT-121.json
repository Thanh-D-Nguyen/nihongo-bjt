{
  "schema": "nihongo-task/1",
  "id": "AUDIT-121",
  "title": "Audit Admin daily-radar card duplication API",
  "start_head": "91fea63d4266a3889d495e5c52376984b7b5b845",
  "preexisting_changes": {},
  "spec": {
    "problem": "POST daily-radar card duplication is not protected consistently and cannot copy the Prisma-backed card schema; the route lacks write permission and CSRF middleware, while SQL references nonexistent legacy columns.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "A roleless Admin POST is denied and creates no card."
      },
      {
        "id": "AC2",
        "text": "A write-authorized Admin request without a trusted Origin is denied; a trusted request duplicates source content as an unpublished draft with a unique slug and a matching audit log."
      },
      {
        "id": "AC3",
        "text": "Missing source returns 404; duplicate and audit failures do not leave partial records."
      }
    ],
    "expected_behavior": "Only an admin with admin.content.write and trusted-origin CSRF protection can duplicate an existing card; the copy uses actual daily.daily_radar_card fields, preserves content in a new draft, and commits its audit record atomically.",
    "observed_behavior": "An authenticated admin without admin.content.write can reach the handler; the copy query/insert uses legacy columns, so the endpoint returns source-card-not-found or 500 and never creates an audited draft.",
    "rollback_plan": "Revert only the AUDIT-121 router, handler, tests, task evidence, and audit checkpoint commits; no schema migration or canonical data changes are required."
  },
  "classification": {
    "classes": [
      "AUTH_SECURITY",
      "API_CONTRACT",
      "DATABASE",
      "CI_QUALITY_SYSTEM"
    ],
    "change_kind": "bugfix",
    "rationale": "Fix the endpoint and shrink the canonical SQL drift baseline by one resolved failure; the baseline generator may only remove observed drift."
  },
  "red_exception": null,
  "red_targets": [
    {
      "runner": "go",
      "package": "./internal/httpserver",
      "test": "TestAdminDailyRadarCardDuplicateRequiresContentWrite",
      "expect": "roleless duplicate status="
    },
