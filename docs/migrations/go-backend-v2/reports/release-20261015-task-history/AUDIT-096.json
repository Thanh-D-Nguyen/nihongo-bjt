  "preexisting_changes": {},
  "spec": {
    "problem": "GET /api/daily-radar/cards documents support for limit but always queries with a hard-coded 48, so callers cannot constrain the response size.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "A valid limit query constrains results for unfiltered, moduleKey, and category list variants; malformed, zero, negative, or above-maximum values fall back safely to the default limit."
      }
    ],
    "expected_behavior": "Use valid limits from 1 through 100 in all public list query branches; absent, malformed, nonpositive, or above-maximum values safely use the default 48.",
    "observed_behavior": "Visible browser request /api/daily-radar/cards?limit=2 returned 200 with 48 cards. Handler initializes limit=48 but never reads the query parameter.",
    "rollback_plan": "Revert only the AUDIT-096 handler and regression-test changes; no data migration or persistent data changes are introduced."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DOMAIN_LOGIC"
    ],
    "change_kind": "bugfix",
    "rationale": "Public API pagination behavior is broken across three parameterized SQL variants; keep default 48, constrain valid caller limits, and cover invalid values through PostgreSQL-backed handler tests."
  },
