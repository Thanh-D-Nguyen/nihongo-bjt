  "id": "AUDIT-088",
  "title": "Audit learner pricing screen",
  "start_head": "ebbeec1fb0c228e84c991707f079a644a24d012b",
  "preexisting_changes": {},
  "spec": {
    "problem": "Pricing crashes on missing plan details and its session, checkout, and backend contracts disagree.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous vi/en/ja pricing renders active plan names, prices, quotas, entitlements and links without requiring a learner session."
      },
      {
        "id": "AC2",
        "text": "Authenticated pricing loads the current subscription from the real session-owned subscription endpoint; caller-supplied userId cannot reveal another learner's subscription."
      },
      {
        "id": "AC3",
        "text": "Selecting an upgrade sends the selected plan ID through the CSRF-protected checkout API and renders the returned pending state without falsely claiming a completed purchase."
      },
      {
        "id": "AC4",
        "text": "API failures produce a localized retryable error, and the 390x844 layout has no horizontal overflow."
      }
    ],
    "expected_behavior": "Public plans include canonical quota/entitlement data; subscription access is session-bound; checkout records only an honest pending intent; localized loading errors remain retryable.",
    "observed_behavior": "Visible 390x844 pricing crashes after HTTP 200; subscription summary route is absent; checkout request and persisted SQL do not match contracts.",
    "rollback_plan": "Revert only the Pricing frontend, monetization read/checkout handler, tests, and i18n additions; test subscriptions are cleaned and no canonical plans are changed."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
