    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "All 11 scoped GET/POST method-paths have individually asserted auth, permission/CSRF, contract, and database/error behavior."
      },
      {
        "id": "AC2",
        "text": "Queue controls persist safe disposable state and audit atomically; repeated controls are idempotent or documented as audit events."
      },
      {
        "id": "AC3",
        "text": "Release control actions validate confirmation and persist auditable requests; no real deployment or queue drain side effect is triggered by tests."
      },
      {
        "id": "AC4",
        "text": "Focused PostgreSQL RED/GREEN test passes; full suite is deferred and no commit is created."
      }
    ],
    "expected_behavior": "Each scoped route enforces its documented admin session/RBAC/CSRF boundary, returns a caller-compatible contract, propagates persistence errors, and records control changes safely.",
    "observed_behavior": "The current handler silently tolerates health-query and row errors, queue pause/resume mutations and audit writes are separate, history payloads do not match Admin callers, and queue controls lack strict permission/input validation.",
    "rollback_plan": "Revert the scoped handler and focused AUDIT-163 test; no persistent migrations or production data changes were made."
  },
