{
  "schema": "nihongo-task/1",
  "id": "AUDIT-070",
  "title": "Audit learner shared deck screen",
  "start_head": "c926046421c8c142981a629eadd7ea5488286737",
  "preexisting_changes": {},
  "spec": {
    "problem": "A valid learner deck shared from its detail UI renders as not found because the public preview reads the legacy study.public_deck table and a different DTO; the page also caches preview content after unsharing.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET /api/public/decks/{token} resolves only active, non-archived learning.deck share_token values and returns the screen DTO: Vietnamese/Japanese title and description, total card count, clone count, and at most five frontText/reading samples; it never returns backText or owner identity."
      },
      {
        "id": "AC2",
        "text": "Unshared, archived, or unknown tokens return 404; public preview requests are not cached so unshare takes effect immediately."
      },
      {
        "id": "AC3",
        "text": "The real visible anonymous shared-deck page renders a valid token, shows the correct Vietnamese/Japanese title selection and sample fronts, never exposes answers, and shows the existing not-found state for a revoked token at 390x844 without horizontal overflow."
      },
      {
        "id": "AC4",
        "text": "The clone call-to-action remains navigable and the source deck's card content and owner fields remain private; tests use disposable deck fixtures and do not change canonical vocabulary, kanji, grammar, or BJT authored data."
      }
    ],
    "expected_behavior": "Valid active learning.deck share tokens render the privacy-safe preview immediately; unshared or archived tokens stop resolving immediately without stale cached content.",
    "observed_behavior": "A disposable deck created and shared through the visible learner UI returned POST /api/flashcards/decks/{id}/share 200 with a token, but opening /vi/decks/shared/{token} at 390x844 rendered 'Bộ thẻ không tìm thấy'. The Go public handler queries study.public_deck, while shareToken is stored on learning.deck.",
    "rollback_plan": "Revert the public preview store/handler and page cache-policy changes; keep the regression tests and restore the previous route behavior."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DOMAIN_LOGIC",
      "AUTH_SECURITY",
      "UI_ONLY",
      "CI_QUALITY_SYSTEM"
    ],
    "change_kind": "bugfix",
    "rationale": "The active public share route is bound to a legacy persistence model and DTO, and stale Next data caching can preserve a revoked public preview; fix the shared store boundary and screen fetch policy."
  },
  "red_exception": null,
