{
  "schema": "nihongo-task/1",
  "id": "AUDIT-108",
  "title": "Implement learner in-app notification feed endpoints",
  "start_head": "222502cf995967f5161c6c9917bb4d6b204bdfcd",
  "preexisting_changes": {},
  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET /api/learner/in-app-notifications returns 200 with only the signed-in learner's notifications, newest first, limit default 20 (1..100, invalid limit 400), fields id/kind/payload/readAt/createdAt; anonymous requests return 401."
      },
      {
        "id": "AC2",
        "text": "POST /api/learner/in-app-notifications/{id}/read marks only the learner's own notification read (201, idempotent, keeps first read_at); other users' or unknown ids return 404; malformed id returns 400; anonymous returns 401; CSRF origin check enforced on the write."
      },
      {
        "id": "AC3",
        "text": "The notifications settings page loads preferences and feed without a 404 and marks an item read in the visible browser at 390x844."
      }
    ],
    "expected_behavior": "",
    "observed_behavior": "",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "AUTH_SECURITY",
