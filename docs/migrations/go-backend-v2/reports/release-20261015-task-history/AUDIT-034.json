  "spec": {
    "problem": "The Admin audit page and GET /api/admin/audit expose persisted security/audit data to authenticated Admin actors without audit-read permission.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous GET returns 401."
      },
      {
        "id": "AC2",
        "text": "Authenticated roleless Admin receives 403 and no audit data."
      },
      {
        "id": "AC3",
        "text": "Admin with viewer.audit can list audit events with the existing paginated JSON contract."
      },
      {
        "id": "AC4",
        "text": "Admin with iam.manage can list audit events as the alternate permission."
      },
      {
        "id": "AC5",
        "text": "Visible roleless Admin deep link is denied or its API-backed list shows an explicit forbidden state after the route is fixed."
      }
    ],
    "expected_behavior": "Restrict audit list access to viewer.audit or iam.manage, matching the Admin navigation requirements.",
    "observed_behavior": "Visible roleless Admin with roles=[] and permissions=[] loads /admin/vi/audit, GET /api/admin/audit returns 200 and the UI renders 59 records; anonymous request returns 401.",
    "rollback_plan": "Revert only the audit route middleware and its regression test; no database changes are required."
  },
  "classification": {
    "classes": [
      "AUTH_SECURITY",
      "API_CONTRACT"
    ],
    "change_kind": "bugfix",
    "rationale": ""
  },
