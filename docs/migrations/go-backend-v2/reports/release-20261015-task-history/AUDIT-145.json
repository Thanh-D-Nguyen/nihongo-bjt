{
  "schema": "nihongo-task/1",
  "id": "AUDIT-145",
  "title": "Secure Admin streak and growth campaign APIs",
  "start_head": "54949fd17b539e707f19d08015271bf3f5024b96",
  "preexisting_changes": {},
  "spec": {
    "problem": "Five Admin streak and growth campaign APIs have missing method-level permissions, weak validation, swallowed database/audit errors, and inaccurate mutation persistence contracts.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "POST /api/admin/gamification/streaks requires content-write plus trusted-origin CSRF, validates fields, persists the row and actor audit atomically, and returns its created ID."
      },
      {
        "id": "AC2",
        "text": "PUT /api/admin/gamification/streaks/{id} requires content-write plus CSRF, validates ID and fields, returns 404 for missing rows, and commits update plus actor audit atomically."
      },
      {
        "id": "AC3",
        "text": "DELETE /api/admin/gamification/streaks/{id} requires content-write plus CSRF, reports DB/missing-row errors accurately, and commits deletion plus actor audit atomically."
      },
      {
        "id": "AC4",
        "text": "GET /api/admin/growth/campaigns requires content-read, preserves the existing filtered/paginated contract, and surfaces query, scan, and iteration failures."
      },
      {
        "id": "AC5",
        "text": "POST /api/admin/growth/campaigns requires content-write plus CSRF, validates name/channel/schedule/reason, persists its response and audit atomically, and reports DB failures."
      }
    ],
    "expected_behavior": "Each METHOD+PATH independently enforces route-level RBAC and CSRF, returns accurate validation/not-found/server errors, and persists expected rows and actor-attributed audit state. Closed-database tests return 500, audit-trigger failures roll back mutations, and the visible Admin callers continue to work.",
    "observed_behavior": "Streak POST/PUT/DELETE handlers rely on AdminGuard only, accept weak/unbounded inputs, ignore missing rows and DELETE errors, and do not audit writes. Growth campaign list silently skips row scan failures and omits rows.Err checks; create ignores audit insert failure, does not transact mutation/audit, and relies on a later detail query.",
    "rollback_plan": "Revert the isolated AUDIT-145 code commit. No schema migration is expected; streak and campaign mutations use uniquely named disposable rows and actor audit fixtures that tests remove."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "AUTH_SECURITY",
      "DATABASE"
    ],
    "change_kind": "bugfix",
    "rationale": "Repair existing Admin API authorization, validation, error and atomic-audit contracts without schema changes."
  },
  "red_exception": null,
