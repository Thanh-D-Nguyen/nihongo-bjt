  "title": "Secure Admin leaderboard and pets APIs",
  "start_head": "5d2b6bbcb6ca5c20ff4cecdebd96b8bd2a1b9d72",
  "preexisting_changes": {},
  "spec": {
    "problem": "Admin leaderboard and companion-pet endpoints are not individually verified; leaderboard mutations lack complete input, permission, CSRF and audit contracts, and pet listing needs authenticated read checks.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Five APIs are individually inventoried and tested; roleless/anonymous behavior is denied; mutations validate, persist, audit atomically and return accurate errors; headed 390x844 browser, Go suite, independent review pass."
      }
    ],
    "expected_behavior": "The five target APIs enforce read/write RBAC and mutation CSRF, validate bounds, return correct errors, preserve history while auditing atomically, and render usable 390px table interactions.",
    "observed_behavior": "The five registered METHOD+PATH routes have session-only guards; leaderboard CRUD lacks consistent schema validation, audit transactions and missing-record behavior, list handlers mask row errors, and the table action column clips at 390px.",
    "rollback_plan": "Revert the isolated AUDIT-143 code commit. No database migration is required; Go/browser checks use disposable rows and explicit cleanup, and the UI adjustment only wraps existing tables in keyboard-focusable scroll regions."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
