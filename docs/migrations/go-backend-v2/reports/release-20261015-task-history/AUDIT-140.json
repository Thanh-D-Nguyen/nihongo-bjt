  "id": "AUDIT-140",
  "title": "Fix five Admin Loto API contracts",
  "start_head": "48e134c48ce93eee8c7817f15e3d36b43299193e",
  "preexisting_changes": {},
  "spec": {
    "problem": "Five active Admin Loto method/path entries need individual contract, authorization, validation, and persistence verification.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "POST /api/admin/magazine/loto/generate is tested individually for authorization, valid generation, duplicates, invalid game/date/count inputs, response contract, persistence, and audit behavior."
      },
      {
        "id": "AC2",
        "text": "POST /api/admin/magazine/loto/import-csv is tested individually for authorization, valid CSV import, malformed/invalid rows, duplicate behavior, response contract, persistence, and safe handling of partial input."
      },
      {
        "id": "AC3",
        "text": "GET /api/admin/magazine/loto/predictions is tested individually for anonymous/roleless denial, authorized contract, query handling, and read consistency."
      },
      {
        "id": "AC4",
        "text": "GET /api/admin/magazine/loto/predictions/analytics is tested individually for anonymous/roleless denial, valid game contract, invalid game handling, and aggregate field correctness."
      },
      {
        "id": "AC5",
        "text": "POST /api/admin/magazine/loto/predictions/results is tested individually for authorization/CSRF, valid upsert/persistence, malformed body/date/game/numbers, and stable duplicate behavior."
      },
      {
        "id": "AC6",
        "text": "A visible headed 390x844 Admin session exercises each practical UI trigger, validates the corresponding API response and resulting view, and shows no unexpected page/console errors."
      },
      {
        "id": "AC7",
        "text": "Update each API verdict, task checkpoint, and report immediately; commit the five-entry wave only after all five pass individually."
      },
      {
        "id": "AC8",
        "text": "Preserve existing canonical authored content and leave no disposable test data after verification."
      }
    ],
    "expected_behavior": "Each of the five APIs returns its documented contract, enforces Admin permission/CSRF, rejects malformed or invalid inputs safely, and persists expected side effects without 5xx or data corruption.",
    "observed_behavior": "Audit-138 secured the route group, but these five entries have not yet had individual request/response, invalid-input, persistence, and caller checks.",
    "rollback_plan": "Remove the task's newly generated disposable fixtures through the supported cleanup helper."
  },
