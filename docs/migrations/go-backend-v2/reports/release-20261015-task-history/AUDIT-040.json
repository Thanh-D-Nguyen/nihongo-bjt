  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "POST /api/admin/battle/configs stores and returns the text[] botDifficulties contract; roleless Admin receives 403 with no config or audit side effect; authorized Admin creates one draft and audit row. Existing Admin UI flow succeeds with a permissioned session."
      },
      {
        "id": "AC2",
        "text": "POST /api/admin/battle/configs/{id}/duplicate copies text[] botDifficulties and scoring rules into a new draft, responds with detail and writes one audit row; roleless Admin receives 403 and anonymous 401."
      }
    ],
    "expected_behavior": "Duplicate succeeds for battle.manage, preserves array values, creates a draft and audit; unauthorized callers cannot create a clone.",
    "observed_behavior": "After create was corrected, the duplicate handler still scans PostgreSQL text[] into []byte and JSON-passes bytes back to text[]; its source fixture is an existing persisted config with bot_difficulties={medium}.",
    "rollback_plan": "Revert the route middleware and pass the request []string directly to pgx; remove the disposable integration fixtures through test cleanup."
  },
