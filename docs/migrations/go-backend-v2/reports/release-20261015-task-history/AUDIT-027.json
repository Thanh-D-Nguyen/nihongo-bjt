  "spec": {
    "problem": "GET /api/analytics accepts userId from the query even though LearnerGuard has authenticated identity in request context, enabling cross-learner analytics access.",
    "acceptance": [
      {
        "id": "session_identity",
        "text": "Analytics reads are always scoped to the authenticated learner, regardless of a supplied userId query parameter."
      },
      {
        "id": "auth_boundary",
        "text": "The route remains session guarded and unauthenticated requests receive 401."
      }
    ],
    "expected_behavior": "GET /api/analytics returns aggregates for the learner identified by the validated session only.",
    "observed_behavior": "A real learner session can request an arbitrary userId; the handler queries that ID and echoes it.",
    "rollback_plan": "Revert the handler and regression test together; keep the route guard intact."
  },
