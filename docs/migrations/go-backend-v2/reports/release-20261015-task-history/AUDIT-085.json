{
  "schema": "nihongo-task/1",
  "id": "AUDIT-085",
  "title": "Audit learner magazine Loto screen",
  "start_head": "d6ac0e9c810a74a1a13aba26b30c8a240bea3175",
  "preexisting_changes": {},
  "spec": {
    "problem": "The learner Loto route crashes for a legitimate missing prediction (hero reads numbers.slice on undefined); the Go feed API returns a raw array although its UI caller requires {data,total}, and ignores pagination parameters.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Authorized learner can load Loto 6 and Loto 7 in vi/en/ja, render an explicit empty state when no draw exists, and use paginated feed data without crashing."
      },
      {
        "id": "AC2",
        "text": "Anonymous visitors receive the established login gate; valid feed results display and paginate; API and UI failures remain distinguishable and retryable."
      },
      {
        "id": "AC3",
        "text": "At 390x844 the screen has no horizontal overflow, error boundary, unexpected console errors, or failed requests; feed/stats contracts, invalid input, and database failures have regression tests."
      }
    ],
    "expected_behavior": "A missing prediction is a valid empty state. The learner consumes the next-draw envelope correctly; feed and stats APIs reject unknown games and surface database errors, while feed returns its paginated envelope and honors bounded page/limit.",
    "observed_behavior": "Visible Chrome console showed LotoHeroPrediction reading slice of undefined because the client stored the {nextDraw:null} response envelope. The feed returned a bare array while the client required {data,total}; pagination was ignored. Stats also returned HTTP 200 for invalid games and database errors.",
    "rollback_plan": "Revert the single AUDIT-085 commit; tests use disposable PostgreSQL rows and clean them up, and no canonical Loto data is changed."
  },
  "classification": {
    "classes": [
      "DOMAIN_LOGIC",
      "API_CONTRACT",
      "CI_QUALITY_SYSTEM"
    ],
    "change_kind": "bugfix",
    "rationale": ""
  },
