  "spec": {
    "problem": "GET /api/admin/daily-radar/cards/{id} returned a false 404 because the joined query was ambiguous and its scan count did not match.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET /api/admin/daily-radar/cards/{id} returns the persisted card contract through the authenticated Admin origin; nonexistent IDs return not-found; the regression test fails against the current handler."
      },
      {
        "id": "AC2",
        "text": "PostgreSQL integration test verifies persisted detail fields and missing-ID 404; visible authenticated Admin same-origin request returns 200."
      }
    ],
    "expected_behavior": "Persisted card details return 200; missing IDs return 404; unexpected DB failures return logged 500.",
    "observed_behavior": "The authenticated visible Admin request returned 404 for a persisted card; after fixing scan alignment the handler exposed an ambiguous id database error.",
