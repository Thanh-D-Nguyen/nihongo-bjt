  "title": "Audit learner linked accounts settings screen",
  "start_head": "fbf8db95c2d5dd61ee3f9e09b477062360269e64",
  "preexisting_changes": {},
  "spec": {
    "problem": "Audit the current /:locale/settings/accounts screen and its security behavior, visible state, primary interactions and mobile layout.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Open the visible authenticated route; inspect account-link state, actions, requests, console/page errors and 390x844 layout."
      },
      {
        "id": "AC2",
        "text": "Verify anonymous access behavior and any linked-account mutation only through the UI; do not change real linked accounts."
      },
      {
        "id": "AC3",
        "text": "Real learner UI loads identities with HTTP 200 and shows a localized empty or connected state; anonymous access is rejected and caller-supplied userId cannot read or delete another learner's identity."
      },
      {
        "id": "AC4",
        "text": "A real UI unlink request is protected by CSRF and only deletes the authenticated learner's identity; both account-settings routes using this API remain compatible."
      }
    ],
    "expected_behavior": "GET/DELETE identities are session-scoped and derive ownership from the authenticated learner, never the userId query; writes require CSRF, and the screen renders an empty/connected/error state rather than remaining stuck.",
    "observed_behavior": "Visible authenticated /vi/settings/accounts issues GET /api/auth/identities?userId=... twice, both return 404, leaving the page on raw 'load' text; the Go router has no identities GET/DELETE route despite an OAuth identity table and two web callers.",
    "rollback_plan": "Remove the identities routes and handlers/tests and restore the prior client only if no other caller depends on them."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "AUTH_SECURITY",
      "UI_ONLY"
    ],
    "change_kind": "bugfix",
    "rationale": "The active UI uses missing Go endpoints; ownership and mutation must be enforced server-side from the authenticated session."
  },
  "red_exception": null,
