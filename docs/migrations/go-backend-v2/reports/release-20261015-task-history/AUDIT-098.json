{
  "schema": "nihongo-task/1",
  "id": "AUDIT-098",
  "title": "Audit learner Review Inbox preview screen",
  "start_head": "bda94fbca40e83a4358629b1f862169e5217ee58",
  "preexisting_changes": {},
  "spec": {
    "problem": "The Review Inbox route silently treats HTTP 401 and database/query failures as an empty inbox; its Go DTO does not match the client ContextMemo contract and the queried context_memo table has no canonical Prisma schema/migration.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous access to the private inbox redirects to localized login; authenticated empty inbox has truthful localized copy; load/database failures never masquerade as empty data."
      },
      {
        "id": "AC2",
        "text": "Canonical PostgreSQL stores inbox memo payloads and the public DTO fields expected by the card UI; ownership remains user-scoped and a visible real learner session renders persisted entries."
      },
      {
        "id": "AC3",
        "text": "Learners can persist memo feedback on their own inbox entries; another learner cannot read or update that entry."
      },
      {
        "id": "AC4",
        "text": "If the feedback request returns 401 because the learner session expired, redirect to the localized login page with the Review Inbox return path."
      },
      {
        "id": "AC5",
        "text": "The feedback PATCH route rejects anonymous or untrusted cross-site requests, validates the feedback value, and cannot expose another learner’s memo."
      }
    ],
    "expected_behavior": "Only a successful authenticated query returning zero rows renders the localized empty state. Anonymous users are sent to login with returnTo. Database errors are surfaced. Persisted memo payloads are returned in the typed UI contract.",
    "observed_behavior": "Visible Chrome showed anonymous GET /api/career/inbox=401 while the page rendered only an em dash. Authenticated GET returned 200 [] because GetInbox suppresses query errors with a comment that the table may not exist; Prisma has no context_memo model/migration. The current Go DTO nests payload while the UI expects flattened ContextMemo fields.",
    "rollback_plan": "Revert only AUDIT-098-owned inbox UI/API/schema/migration/test changes; no canonical learner content or unrelated account data is deleted."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DATABASE",
      "DOMAIN_LOGIC",
      "UI_ONLY",
      "CI_QUALITY_SYSTEM"
    ],
    "change_kind": "bugfix",
    "rationale": "Private learner data and its UI contract are broken; add the missing canonical persistence schema and surface real auth/error/empty states while preserving per-user access."
  },
  "red_exception": null,
