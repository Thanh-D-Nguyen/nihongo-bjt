{
  "schema": "nihongo-task/1",
  "id": "AUDIT-116",
  "title": "Return coherent timestamps for default notification preferences",
  "start_head": "2d4e033e3a173e82aa3c4bf68e5de151726c9a86",
  "preexisting_changes": {},
  "spec": {
    "problem": "A learner without a persisted notification-preference row receives zero-value timestamps in the GET response, which do not match the timestamp fields supplied after a save.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET notification preferences for a user with no persisted row returns defaults with non-zero createdAt and updatedAt; first partial PUT preserves all default fields and persists timestamps."
      }
    ],
    "expected_behavior": "The default response includes one non-zero UTC timestamp for both createdAt and updatedAt and does not persist a row until the learner saves.",
    "observed_behavior": "GET /api/learner/notification-preferences returns the current boolean defaults but serializes createdAt and updatedAt as Go zero time when no row exists.",
    "rollback_plan": "No schema or persisted data changes; reverting restores the prior zero-time response. The fix can be rolled back with the code/test commit."
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DATABASE"
