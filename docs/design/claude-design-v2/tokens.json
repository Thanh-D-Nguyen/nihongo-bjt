{
  "$meta": {
    "product": "KotobaWorks / Nihongo BJT — Learner UI",
    "version": "v2-final",
    "direction": "Quiet Mastery for Business Japanese",
    "scope": "Learner web + native mobile only. Admin excluded.",
    "note": "Source of truth for implementation. Mirror into apps/web/app/globals.css custom properties and the Flutter/RN theme. All visible strings are example copy → i18n keys.",
    "platforms": { "web": "Next.js", "mobile": "Flutter or React Native" }
  },

  "color": {
    "brand": {
      "navy":        { "value": "#1B2A4A", "role": "Primary CTA, headers, authority anchor" },
      "navyHover":   { "value": "#243560", "role": "Hover for navy" },
      "navyPressed": { "value": "#141F38", "role": "Active/pressed for navy" }
    },
    "interactive": {
      "blue":      { "value": "#3B82F6", "role": "Links, secondary CTA, focus ring" },
      "blueHover": { "value": "#2563EB" },
      "blueLight": { "value": "#DBEAFE", "role": "Tag bg, selected row" },
      "sky":       { "value": "#EFF6FF", "role": "Soft highlight, active nav" }
    },
    "semantic": {
      "success":   { "value": "#059669" }, "successBg": { "value": "#ECFDF5" },
      "warning":   { "value": "#D97706" }, "warningBg": { "value": "#FFFBEB" },
      "danger":    { "value": "#DC2626" }, "dangerBg":  { "value": "#FEF2F2" }
    },
    "reward": {
      "sakura": { "value": "#F9A8D4", "role": "Achievement glow — sparse only" },
      "gold":   { "value": "#F59E0B", "role": "Premium/milestone — never primary CTA" }
    },
    "neutral": {
      "ink":          { "value": "#111827", "role": "Primary text (never pure #000)" },
      "secondary":    { "value": "#4B5563" },
      "tertiary":     { "value": "#9CA3AF" },
      "canvas":       { "value": "#F8FAFC", "role": "Page background" },
      "surface":      { "value": "#FFFFFF" },
      "surfaceHover": { "value": "#F1F5F9" },
      "border":       { "value": "#E2E8F0" },
      "borderHover":  { "value": "#CBD5E1" }
    },
    "srs": {
      "new":      { "value": "#8B5CF6" },
      "learning": { "value": "#F59E0B" },
      "review":   { "value": "#3B82F6" },
      "mastered": { "value": "#059669" }
    },
    "battle": {
      "player":      { "value": "#3B82F6" },
      "opponent":    { "value": "#EF4444" },
      "timer":       { "value": "#F59E0B" },
      "timerUrgent": { "value": "#DC2626" }
    },
    "rules": [
      "No single hue may dominate the whole app.",
      "Semantic colors carry meaning, never decoration.",
      "Sakura/Gold are reward accents only — never nav, borders, or body.",
      "Never rely on color alone to communicate state (add icon + label)."
    ]
  },

  "typography": {
    "fontFamily": {
      "ui":   "'Inter', 'Noto Sans JP', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "jp":   "'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', Consolas, monospace"
    },
    "scale": {
      "display":       { "desktop": 36, "mobile": 28, "weight": 700, "lineHeight": 1.2 },
      "h1":            { "desktop": 30, "mobile": 24, "weight": 700, "lineHeight": 1.3 },
      "h2":            { "desktop": 24, "mobile": 20, "weight": 600, "lineHeight": 1.35 },
      "h3":            { "desktop": 20, "mobile": 18, "weight": 600, "lineHeight": 1.4 },
      "h4":            { "desktop": 16, "mobile": 16, "weight": 600, "lineHeight": 1.4 },
      "body":          { "desktop": 15, "mobile": 14, "weight": 400, "lineHeight": 1.6 },
      "bodySmall":     { "desktop": 13, "mobile": 13, "weight": 400, "lineHeight": 1.5 },
      "caption":       { "desktop": 12, "mobile": 11, "weight": 400, "lineHeight": 1.4 },
      "overline":      { "desktop": 11, "mobile": 11, "weight": 600, "lineHeight": 1.2, "letterSpacing": "0.05em", "transform": "uppercase" },
      "jpHeadword":    { "desktop": 28, "mobile": 24, "weight": 700, "lineHeight": 1.4, "letterSpacing": "0.02em", "font": "jp" },
      "jpExample":     { "desktop": 16, "mobile": 15, "weight": 400, "lineHeight": 1.8, "letterSpacing": "0.01em", "font": "jp" },
      "jpFurigana":    { "size": "0.52em", "weight": 400, "font": "jp", "note": "ruby rt — must not collide; passages need LH 1.8" },
      "flashcardFront":{ "desktop": 32, "mobile": 28, "weight": 700, "font": "jp" }
    },
    "rules": [
      "Japanese body line-height 1.6–1.8 (1.8 for passages with furigana); never below 1.5.",
      "Minimum Japanese size 14px at any viewport.",
      "font-variant-numeric: tabular-nums for timers, scores, quotas, streaks, analytics.",
      "No negative letter-spacing anywhere.",
      "Apply OpenType 'palt' to JP headings/nav only; 'kern' for mixed JP/Latin.",
      "Japanese text areas: word-break:keep-all; overflow-wrap:break-word; line-break:strict."
    ]
  },

  "spacing": { "unit": 4, "xs": 4, "s": 8, "m": 16, "l": 24, "xl": 32, "xxl": 48 },

  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 20, "full": 9999, "note": "No sharp corners — min 6px." },

  "elevation": {
    "shadowXs": "0 1px 2px rgba(15,23,42,0.04)",
    "shadowSm": "0 1px 3px rgba(15,23,42,0.06), 0 1px 2px rgba(15,23,42,0.04)",
    "shadowMd": "0 4px 6px -1px rgba(15,23,42,0.07), 0 2px 4px -1px rgba(15,23,42,0.04)",
    "shadowLg": "0 10px 15px -3px rgba(15,23,42,0.08), 0 4px 6px -2px rgba(15,23,42,0.03)",
    "shadowXl": "0 20px 25px -5px rgba(15,23,42,0.10), 0 10px 10px -5px rgba(15,23,42,0.04)"
  },

  "breakpoints": {
    "web": {
      "mobile":  { "maxWidth": 639, "design": 375, "layout": "single column, hamburger, sticky top bar, NO bottom tab bar" },
      "tablet":  { "min": 640, "max": 1023, "design": 768, "layout": "single column; context rail collapses to 2-up below the spine" },
      "desktop": { "min": 1024, "max": 1279, "design": 1024, "layout": "two-column, spine + rail" },
      "wide":    { "min": 1280, "design": 1440, "layout": "max content 1280, 32px gutters, rail fixed 300px" }
    },
    "native": {
      "base":  { "design": 375, "note": "primary CTA 48px, thumb-zone actions, safe-area aware" },
      "large": { "design": 430, "note": "type +1–2px, spacing scales, content max-width holds (no stretched cards)" }
    }
  },

  "touchTarget": { "webMin": 44, "nativeMin": 44, "nativePrimary": 48, "unit": "px" },

  "motion": {
    "pressFeedbackMs": 150,
    "transitionRangeMs": [150, 300],
    "easing": "ease-out",
    "rules": [
      "Press feedback: scale 0.98 + pressed color.",
      "Respect prefers-reduced-motion (disable transforms, keep opacity).",
      "No animation during active study or timed exam.",
      "No autoplay audio/video — audio only from explicit learner action.",
      "One primary CTA per viewport."
    ]
  },

  "components": {
    "button": {
      "variants": ["primary-navy", "secondary-blue-outline", "danger", "ghost"],
      "states": ["default", "hover", "focus-visible", "active", "loading", "disabled"],
      "radius": 10, "minHeight": 44, "minHeightMobilePrimary": 48,
      "primary": { "bg": "#1B2A4A", "text": "#FFFFFF", "hover": "#243560", "active": "#141F38" },
      "secondary": { "bg": "transparent", "text": "#3B82F6", "border": "1.5px solid #3B82F6", "hoverBg": "#EFF6FF" },
      "danger": { "bg": "#DC2626", "text": "#FFFFFF", "hover": "#B91C1C" },
      "focusRing": "3px solid #3B82F6, 2px offset"
    },
    "input": { "bg": "#FFFFFF", "border": "1px solid #E2E8F0", "borderHover": "1px solid #CBD5E1", "borderFocus": "2px solid #3B82F6", "borderError": "1px solid #DC2626", "radius": 10, "minHeight": 44, "padding": "10px 14px", "fontSize": 15 },
    "card": { "bg": "#FFFFFF", "border": "1px solid #E2E8F0", "radius": [14, 20], "padding": [16, 24], "shadow": "shadowSm", "hoverShadow": "shadowMd" },
    "badge": { "radius": 9999, "padding": "4px 10px", "fontSize": 12, "weight": 500 },
    "segmentedControl": { "trackBg": "#F1F5F9", "activeBg": "#FFFFFF", "activeShadow": "shadowSm", "recommendedOptions": "2-3" },
    "quizOption": { "states": ["default", "selected", "correct", "incorrect", "disabled"], "correct": { "border": "#059669", "bg": "#ECFDF5", "icon": "checkmark + text" }, "incorrect": { "border": "#DC2626", "bg": "#FEF2F2", "icon": "cross + text" } },
    "questionNavigator": { "states": ["answered", "flagged", "current", "unanswered"], "flagged": "#F59E0B" }
  },

  "examIntegrity": {
    "timedExam": [
      "No meanings revealed during active timed exam mode.",
      "Reading Assist limited to permitted furigana only if the product mode allows; meanings appear only after answering or outside timed mode.",
      "No playful rewards/animation during active exam.",
      "Mock exam requires a connection to start and submit (offline state says so plainly; never fakes a local run)."
    ]
  },

  "monetization": {
    "rules": [
      "Enforcement is server-side. UI reflects server state; never gate client-only.",
      "Basic reading support (furigana, readings, meaning) stays free.",
      "No manipulative countdowns or shame copy.",
      "Paywall/quota surfaces visually distinct from learning controls; ads never interrupt active study/review/exam."
    ]
  },

  "privacy": {
    "rules": [
      "Sharing is opt-in and privacy-safe; preview before publish.",
      "Public share tokens & OG metadata expose safe metadata only — no scores, learning history, or estimated BJT band.",
      "Estimated BJT band/score is private until the learner explicitly shares."
    ]
  },

  "i18n": {
    "locales": { "ui": "vi", "content": "ja", "extensible": true },
    "namespaces": ["common","auth","home","learn","lesson","review","quiz","exam","search","dict","progress","profile","billing","share","errors"],
    "keyPattern": "<namespace>.<screen>.<element>",
    "examples": {
      "home.hub.continue_cta": "Tiếp tục học",
      "quiz.feedback.incorrect_intro": "Chưa đúng — và đó là một phần của việc học.",
      "progress.band.estimated_label": "ước lượng",
      "review.confidence.again": "Lại"
    },
    "rules": [
      "All visible strings are example copy → i18n keys.",
      "Japanese headwords/examples are content data, never inside UI keys.",
      "Tone: supportive, precise, adult, no-shame.",
      "ICU plural & number formatting; tabular-nums for counts."
    ]
  }
}
