  "spec": {
    "problem": "Production refresh-life-feed failed closed with the misleading 'unverified Wikidata identity/revision for tokyo' while Wikidata was healthy for reads",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Wikidata geography request no longer sends maxlag: a read-only 10-entity wbgetentities call must not be throttled by unrelated query-service (WDQS) replication lag; identifying User-Agent and one-request-per-run are preserved"
      },
      {
        "id": "AC2",
        "text": "An HTTP 200 body carrying a MediaWiki API error object (e.g. code maxlag) fails closed with an explicit 'Wikidata API error' naming the code and info, not the misleading 'unverified Wikidata identity/revision' message"
      },
      {
        "id": "AC3",
        "text": "Verification (identity, revision, modified time, ja label, P17=Q17), 48h TTL and publish-nothing-on-error behavior are unchanged; all existing lifefeed tests still pass"
      }
    ],
    "expected_behavior": "A read-only wbgetentities call is not throttled by unrelated query-service lag; any MediaWiki API error body fails the run explicitly with its code and info and publishes nothing",
    "observed_behavior": "Request carried maxlag=5; Wikidata counted WDQS query-service lag (5.6-7.5s, persisted >1h) and answered HTTP 200 with an {error:{code:maxlag}} body, which decoded to zero entities",
    "rollback_plan": "Revert the commit; the previous behavior fails closed and leaves the last valid snapshot intact"
  },
  "classification": {
    "classes": [
      "DOMAIN_LOGIC"
    ],
