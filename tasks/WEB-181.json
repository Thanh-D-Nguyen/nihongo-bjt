  "spec": {
    "problem": "Kanji stroke tiles consume list DTOs without stroke paths, and animation expects raw SVG while Go serves JSON. Next.js 16.4.0 requires the requested security patch upgrade.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "政府会議 renders four kanji SVGs and plays strokes sequentially with replay, including dark mode and reduced motion."
      },
      {
        "id": "AC2",
        "text": "SVG representation is scoped to canonical local stroke files with traversal/symlink protection; existing JSON metadata remains compatible."
      },
      {
        "id": "AC3",
        "text": "Apply Next.js security upgrade 16.4.0 to 16.4.3 and verify learner/admin builds and runtime."
      }
    ],
    "expected_behavior": "Detailed kanji data and image/svg+xml negotiation deliver real drawable SVG paths; approved security patch runs across the workspace.",
    "observed_behavior": "Tiles only show characters; list response omits stroke paths and stroke endpoint is JSON-only.",
    "rollback_plan": "Revert task commits to restore prior frontend/API and dependency manifests."
  },
