{
  "schema": "nihongo-task/1",
  "id": "SHIBA-401",
  "title": "Connect Shiba companion chat to self-hosted local LLM",
  "start_head": "2ed75948de9416d2bf8c5a07507438475978ed45",
  "preexisting_changes": {},
  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "POST /api/companion/chat requires a learner session and CSRF-valid origin; anonymous requests are rejected"
      },
      {
        "id": "AC2",
        "text": "Given SHIBA_LLM_BASE_URL configured, a learner message plus recent history returns a reply generated by the configured OpenAI-compatible endpoint with the configured model, and the response identifies the model used"
      },
      {
        "id": "AC3",
        "text": "When the LLM endpoint is not configured, the endpoint returns 503 with a stable error code and the web companion keeps answering with the existing rule-based replies"
      },
      {
        "id": "AC4",
        "text": "When the LLM endpoint errors or times out, the endpoint returns 502 with a stable error code and never leaks upstream details or credentials"
      },
      {
        "id": "AC5",
        "text": "Requests validate message and history bounds (message 1-1000 runes, at most 20 history turns, roles user/assistant only) and are rate-limited per learner"
      },
      {
        "id": "AC6",
        "text": "The web companion sends the learner's recent conversation turns to the API and renders the LLM reply in the chat panel for the active locale; quick replies keep working"
      },
      {
        "id": "AC7",
        "text": "LLM endpoint, model, timeout and optional Cloudflare Access service-token credentials are configured only via server-side environment variables documented in .env.example; no secret appears in frontend code or API responses"
      }
    ],
    "expected_behavior": "",
    "observed_behavior": "",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "API_CONTRACT",
      "DOMAIN_LOGIC",
      "UI_ONLY",
      "CROSS_CUTTING"
    ],
    "change_kind": "add",
    "rationale": "New learner chat endpoint (API contract) backed by an OpenAI-compatible LLM provider service (domain logic), wired into the existing companion web UI (UI only), spanning Go API, config and web frontend (cross-cutting). Auth reuses the existing learner session guard and CSRF guard without changing auth behavior."
  },
