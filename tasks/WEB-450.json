{
  "schema": "nihongo-task/1",
  "id": "WEB-450",
  "title": "Deterministic serve-time option shuffle to fix BJT answer-position bias",
  "start_head": "8b8fd2df3563cbf6acd94feea117ac8730d3411e",
  "preexisting_changes": {
    ".build/.buildSystem_debug": "c337257139e569398ce8bf081a54dbc7d1e0267d",
    ".build/CACHEDIR.TAG": "b7ab0d883e974d20c05898291a6218954e18e5ef"
  },
  "spec": {
    "problem": "Learner-facing BJT quiz, printable template, placement, battle, and scenario endpoints return answer options in stored ORDER BY option_key order, exposing severe stored-data answer-position bias (57.3% B, 75.3% A+B across 846 published BJT questions; 100% A on seeded business scenario steps).",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Quiz session question serving deterministically shuffles options by (sessionId, questionId): stable on refetch, 15-35% per slot over >=400 sessions when correct answer is stored only at B, and grading resolves by optionKey."
      },
      {
        "id": "AC2",
        "text": "Printable quiz template serving deterministically shuffles options by (templateId, questionId): stable on refetch, 15-35% per slot over >=400 questions, keeping key bound to text and correctKey matching the correct option's key."
      },
      {
        "id": "AC3",
        "text": "Placement/diagnostic serving deterministically shuffles options by (sessionId, questionId) consistently across start, resume, and onboarding status, and grades by optionKey."
      },
      {
        "id": "AC4",
        "text": "Battle question serving (bot, PvP, and in-memory fallback) deterministically shuffles options by (fairnessSeed, questionId) with identical PvP/resync order and grading by optionKey."
      },
      {
        "id": "AC5",
        "text": "Scenario step choices are audited and deterministically shuffled per learner+step while preserving choiceKey binding and grading by choiceKey."
      },
      {
        "id": "AC6",
        "text": "Web quiz, printable exam, placement, battle speed-duel, and scenario views render positional A/B/C/D labels matching keyboard shortcuts and printed answer-sheet bubbles while submitting canonical optionKey/choiceKey."
      },
      {
        "id": "AC7",
        "text": "Admin question-bank authoring endpoints remain canonical (unshuffled) and stored question data is untouched."
      }
    ],
    "expected_behavior": "Learner-facing serve paths deterministically Fisher-Yates shuffle options using (session/attempt/template/user id + question/step id) while keeping optionKey/choiceKey bound to its text and grading by key; identical (seed, question) always returns identical order; across >=400 seeds correct answers stored only at B distribute ~uniformly (15-35% per position); admin question-bank endpoints remain canonical; web UI renders positional A/B/C/D labels while submitting canonical optionKey/choiceKey.",
    "observed_behavior": "GET /api/quiz/session/{id}/question, GET /api/quiz/templates/{id}/printable, POST /api/learner/placement/start + GET /api/learner/onboarding, battle question loading (CreateBotBattle/CreatePvpBattle/defaultInMemoryBattle), and GET /api/scenarios/{id} return options/choices in canonical A/B/C/D order without shuffling; web views render raw optionKey/choiceKey badges.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "DOMAIN_LOGIC",
      "API_CONTRACT",
      "REALTIME",
      "UI_ONLY"
    ],
    "change_kind": "bugfix",
    "rationale": "Fixes answer-position bias across BJT quiz sessions, printable templates, placement, realtime battles, and scenarios with deterministic serve-time Fisher-Yates option shuffle and positional web display labels."
  },
