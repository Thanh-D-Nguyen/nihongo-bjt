  "spec": {
    "problem": "The Go API has hundreds of /api routes while the canonical mobile OpenAPI documents only a small verified subset; static discovery may silently miss registrations.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "All direct /api registrations in NewRouter are inventoried with source conditions and explicit runtime verification status; /health and /ws belong to separate router surfaces"
      },
      {
        "id": "AC2",
        "text": "OpenAPI method/path coverage matches direct NewRouter /api registrations, unsupported patterns fail closed, and a live Chi route subset is cross-checked"
      },
      {
        "id": "AC3",
        "text": "Schema coverage distinguishes test-supported verified contracts from unverified source-only records without invented fields or runtime claims"
      }
    ],
    "expected_behavior": "A repeatable static /api route inventory, drift-sensitive OpenAPI generation, supported verification evidence and clearly labeled unknowns.",
    "observed_behavior": "The router exposes conditional groups, With chains and loop-derived routes, while only a small source subset previously had schema evidence.",
    "rollback_plan": "Revert generated OpenAPI/inventory, discovery tests and generator together; the previous verified mobile contract remains in Git history."
  },
