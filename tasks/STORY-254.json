  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "GET /api/story/chapters/{id} requires a learner session (401 without one; answer keys are not public) and returns {chapter,npcs,rewardsPayload} for a chapter of a published arc: chapter has id, arcSlug, slug, displayOrder, titleJa/Vi, briefingJa/Vi, yourRoleVi, isBoss, estimatedMinutes and the scenarios array from scenario_payload"
      },
      {
        "id": "AC2",
        "text": "npcs lists every active story NPC (so reacting NPCs named only in option outcomes resolve) with slug, nameJa, roleJa, companyJa, defaultRelation and avatarInitial/avatarTint/bioVi read from story_npc.avatar_media (first rune of nameJa and empty values only when absent); inactive NPCs are excluded and persona_prompt is never exposed"
      },
      {
        "id": "AC3",
        "text": "Chapters of unpublished arcs, unknown ids and every non-canonical id (including urn:uuid: and padded forms) return 404 'chapter not found' and never reach SQL as invalid input"
      },
      {
        "id": "AC4",
        "text": "GET /api/story/arcs adds synopsisVi, npcSlugs and artAccent from story_payload with safe defaults when absent, and GET /api/story/arcs/{slug} chapters add displayOrder, isBoss and estimatedMinutes; existing fields and route tests are unchanged"
      }
    ],
    "expected_behavior": "",
    "observed_behavior": "",
    "rollback_plan": ""
  },
