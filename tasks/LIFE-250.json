  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Ten supported cities receive reviewed Japanese geography lessons from verified Wikidata CC0 Japan-country facts with correct source timestamps, bilingual explanations, readings and exercises."
      },
      {
        "id": "AC2",
        "text": "An operator-approved fixed template and existing active publisher permission are required; manual edits and blocked/draft lessons are preserved; publication and refresh are audited atomically."
      },
      {
        "id": "AC3",
        "text": "Daily idempotent refresh retains last valid lessons on upstream errors and expires stale lessons; existing feed review gate and MET Norway cache/license checks remain enforced."
      },
      {
        "id": "AC4",
        "text": "Production includes a working reviewed life lesson for each city, MET Norway with real operator contact, and a scheduled refresh with failure-visible execution."
      }
    ],
    "expected_behavior": "Source-backed lessons plus date and licensed live weather are served consistently without fabricating current facts or replacing human-reviewed edits.",
    "observed_behavior": "",
    "rollback_plan": "Disable scheduled refresh and MET_NORWAY_USER_AGENT; archive only this batch managed lessons through audited admin actions; application rollback preserves all other content and accounts."
  },
