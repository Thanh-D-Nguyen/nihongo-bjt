  "id": "SHIBA-402",
  "title": "Sync Shiba LLM env from GitHub vars/secrets in OCI deploy",
  "start_head": "c3751306a05017b06313c6cac4c385dec9597b5b",
  "preexisting_changes": {},
  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "deploy-oci workflow syncs SHIBA_LLM_BASE_URL, SHIBA_LLM_MODEL, SHIBA_LLM_CF_ACCESS_CLIENT_ID and SHIBA_LLM_CF_ACCESS_CLIENT_SECRET from GitHub vars/secrets into the OCI .env.production before releasing"
      },
      {
        "id": "AC2",
        "text": "empty or unset values never modify the env file for that key (no key is ever blanked)"
      },
      {
        "id": "AC3",
        "text": "only the four SHIBA_LLM keys are touched; all other lines and values are preserved byte-for-byte"
      },
      {
        "id": "AC4",
        "text": "sync is idempotent: a second run with the same inputs changes nothing"
      },
      {
        "id": "AC5",
        "text": "secret values are never printed to stdout, stderr or logs"
      },
      {
        "id": "AC6",
        "text": "sync is atomic (temp file + rename) and keeps a single rolling backup of the previous env file"
      },
      {
        "id": "AC7",
        "text": "the sync script ships with a shell test that exercises update, append, empty-skip, idempotency and no-leak behavior"
      }
    ],
    "expected_behavior": "",
    "observed_behavior": "",
    "rollback_plan": ""
  },
