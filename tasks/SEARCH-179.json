{
  "schema": "nihongo-task/1",
  "id": "SEARCH-179",
  "title": "Fix search selection and relevance ordering",
  "start_head": "74f6e10777fac614ca0479d75483088ecae9fc93",
  "preexisting_changes": {},
  "spec": {
    "problem": "Deep-linked search entry state overrides a learner's subsequent selection; multilingual results include partial-token matches that bury stronger all-term matches.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Selecting any visible result works even if the URL initially contains another entry."
      },
      {
        "id": "AC2",
        "text": "Search query ranks results matching every query term ahead of partial matches and falls back when no all-term results exist."
      }
    ],
    "expected_behavior": "A clicked result remains selected despite a stale entry URL; queries return all-term matches first and fall back to partial matches only when strict search has no results.",
    "observed_behavior": "Entry-sync reruns when selected changes and restores the stale target, which blocks URL sync; Meilisearch uses broad last-token matching by default.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "SEARCH",
      "UI_ONLY"
    ],
    "change_kind": "bugfix",
    "rationale": ""
  },
