  "spec": {
    "problem": "Battle lobby actions (challenge_bot, accept_challenge, challenge_user) are queued until battle:lobby_joined, but nothing bounds the wait or clears the queue",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Battle surfaces (lobby, leaderboard, configs panel, hype layer, popovers, match client and every game-types round) render readable in .dark: no bg-white/NN, hover:bg-white or pastel gradient/border/ring/text-*-900 utilities left without a dark treatment"
      },
      {
        "id": "AC2",
        "text": "globals.css provides .dark overrides for the pastel gradient stops, borders, rings, hover tints and text-*-900 shades used by battle components, scoped so solid saturated colours and text-white overlays are unchanged"
      },
      {
        "id": "AC3",
        "text": "Lobby actions (challenge_bot, challenge_user, accept_challenge) queued before battle:lobby_joined run exactly once, in order, when the lobby is joined; they are dropped on teardown"
      },
      {
        "id": "AC4",
        "text": "A queued lobby action that never gets battle:lobby_joined within the timeout is discarded and reported so the bot challenge does not stay stuck on 'connecting'"
      }
    ],
    "expected_behavior": "A queued lobby action that does not get the lobby within 10s is dropped, status leaves 'connecting' with a lobby_timeout error and the pending flag is cleared; cancelling the countdown, leaving to the lobby or expiring an accept clears the queue so nothing is sent late",
    "observed_behavior": "If battle:lobby_joined never arrives (socket gives up after 3 reconnects) a bot challenge stays on 'connecting' forever; a cancelled or expired challenge can still be emitted when the lobby joins late",
    "rollback_plan": "git revert the BAT-276 commit; the queue and dark-mode rules are additive"
  },
