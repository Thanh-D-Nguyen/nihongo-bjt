  "title": "Publish licensed mobile Today Life feed",
  "start_head": "c87d7d002292208013fbe21b48af34c5eec209da",
  "preexisting_changes": {},
  "spec": {
    "problem": "iOS Today Life Hub needs licensed, reviewed live bilingual lesson cards by city with no leaking of unapproved content",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Anonymous GET /api/life/feed validates city and returns only valid reviewed licensed lessons"
      },
      {
        "id": "AC2",
        "text": "Unpublished and uncleared lessons never appear and empty feed responds 404"
      },
      {
        "id": "AC3",
        "text": "Admin editor supports draft/review/publish with RBAC CSRF audit and semantic validation"
      },
      {
        "id": "AC4",
        "text": "Dates and source timestamps remain JST-valid and weather with non-commercial permission is excluded"
      }
    ],
    "expected_behavior": "Server publishes Japanese calendar and commercially reusable weather with rights-cleared editorial lessons using contract version 1; admin edits are gated and audited",
    "observed_behavior": "",
    "rollback_plan": "Roll back Go API and admin deployment; new daily.life_lesson table may be left dormant safely (no destructive migration). Disable MET_NORWAY_USER_AGENT to stop external weather calls; clients fall back to local samples on 404. Retain editorial data and audit history for a forward fix."
  },
