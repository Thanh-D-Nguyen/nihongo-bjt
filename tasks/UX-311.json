  "spec": {
    "problem": "Learner web UI has AI-slop violet/bounce/side-tab patterns, missing mobile bottom navigation, overlapping text in Kanji grid and Search detail header, intrusive full-screen promo modals, redundant homepage NHK news fetches, and unlinked Kanji/Lexeme cross-navigation despite existing Go API support.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Shared layouts, global CSS, and learner screens eliminate AI-slop violet gradients, bounce easings, and side-tab borders"
      },
      {
        "id": "AC2",
        "text": "LearnerAppFrame provides a responsive mobile bottom navigation bar, deduplicated Explore navigation, and reliable review-due badge fetching"
      },
      {
        "id": "AC3",
        "text": "KanjiDetailClient and LexemeDetailClient link vocabulary examples, constituent kanji, and radicals across Dictionary and Kanji detail pages using existing Go APIs"
      },
      {
        "id": "AC4",
        "text": "Kanji grid cards, Search detail preview header, Dictionary list, and Grammar list render cleanly without text collisions or fixture clutter"
      },
      {
        "id": "AC5",
        "text": "ESLint ignores vendored agent skill directories and Next.js rewrites proxy same-origin /api/* calls cleanly"
      }
    ],
    "expected_behavior": "Refined Japanese-inspired minimal workspace with mobile bottom navigation, zero text collisions, non-intrusive announcements, single initial NHK news fetch, entity cross-navigation between Dictionary and Kanji, and clean ESLint skill ignores.",
    "observed_behavior": "Impeccable detector reports 58 slop findings, Kanji Hán-Việt overflows grid cards, Search detail header overlaps guest prompt, mobile lacks bottom nav, and Kanji examples/components are not linked.",
    "rollback_plan": ""
  },
  "classification": {
    "classes": [
      "UI_ONLY",
      "CI_QUALITY_SYSTEM"
    ],
    "change_kind": "modify",
    "rationale": "Overhauls learner web UI/UX, navigation, and cross-entity API wiring while updating ESLint ignores for vendored skill directories"
  },
