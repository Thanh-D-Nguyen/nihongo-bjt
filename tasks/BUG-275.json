  "spec": {
    "problem": "Auto-generate flashcard deck on /flashcards creates no cards: generation and preview only read learning.flashcard_variant, which is a sparse curated pool (80 N5 lexeme variants, 0 kanji/grammar), so most level/source combinations yield an empty deck reported as success.",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Deck preview and generation select canonical content (content.lexeme, content.grammar_point, content.kanji) filtered by JLPT level and source type, so cards are created without a pre-curated variant row"
      },
      {
        "id": "AC2",
        "text": "A curated active flashcard_variant for a source keeps its wording; reverse/both directions reuse or create the variant without duplicates"
      },
      {
        "id": "AC3",
        "text": "When no canonical content matches, generation returns 422 and creates no deck; the dialog shows the server error instead of a silent empty success"
      },
      {
        "id": "AC4",
        "text": "Existing generation contract tests keep passing; a new test fails on the current code without curated variants"
      }
    ],
    "expected_behavior": "Generation and preview select canonical content by level and source type and create the deck with the matching card count; zero matches return 422 and no deck.",
    "observed_behavior": "POST /api/flashcards/decks/generate returns 201 with an empty deck when no curated learning.flashcard_variant rows exist for the requested JLPT level or source type; preview reports the same empty pool.",
    "rollback_plan": "Revert the change; the old endpoints and response shapes are unchanged except the 422 for zero matches."
  },
