    "problem": "Production dashboard 500 on nullable official mock levels plus misleading legacy publication and pass-rate metrics",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Real PostgreSQL route test: NULL/empty levels aggregate once as unknown; published mocks active; JSON keys preserved"
      },
      {
        "id": "AC2",
        "text": "Attempts count only starts in [now minus 30 days, now]; old/future sessions excluded; no recent starts add zero attempts and no fabricated pass rate. Unique fixtures preserve existing data."
      },
      {
        "id": "AC3",
        "text": "bjtPassRate30d stays null with partial_schema_pending bjt_pass_rate_30d: no canonical pass threshold/result exists"
      }
    ],
    "expected_behavior": "Stable dashboard JSON; NULL and empty levels share unknown bucket; published mocks counted; starts bounded to last 30 days through now; pass rate null until canonical pass semantics exist. Tests preserve existing data using unique fixtures and baseline deltas.",
    "observed_behavior": "NULL mock level fails string scan with HTTP 500; active status is obsolete; all-time submitted count masquerades as pass rate",
    "rollback_plan": "Revert handler and its focused regression test; no schema or stored data changes"
  },
