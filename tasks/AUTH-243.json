  "preexisting_changes": {},
  "spec": {
    "problem": "",
    "acceptance": [
      {
        "id": "AC1",
        "text": "Web login displays a Google button and translated divider when OAuth is configured"
      },
      {
        "id": "AC2",
        "text": "Google ID token reaches Go API with session cookie; native Bearer logout does not break browser CSRF protection"
      },
      {
        "id": "AC3",
        "text": "Production OCI build passes web Google client ID to build, and Go service receives the same ID"
      },
      {
        "id": "AC4",
        "text": "Existing email login and admin routes remain reachable; production health verified"
      }
    ],
    "expected_behavior": "Show the Google login option with an accessible divider; inject matching OAuth client ID into the OCI API and web build; allow Bearer-only native logout while protecting cookie requests",
    "observed_behavior": "The existing Google login button has no distinct divider and OCI builds lack the public OAuth client ID and API audience configuration; native Bearer-only logout is blocked by CSRF",
    "rollback_plan": "Revert the release commit; OCI deploy-release.sh can restore pinned prior app images and Caddy configuration"
  },
