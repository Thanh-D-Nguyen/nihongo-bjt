# M16: Go API serves all endpoints on :4001. NestJS (apps/api/) preserved for rollback only.
# Auth is Go-native sessions (M13a/b/c) — Keycloak vars below are legacy/dead.

NODE_ENV="development"

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:15432/nihongo_bjt?schema=content"
# M15: NestJS API port removed. Go API listens on 4001.
# API_PORT="4000"  # STALE — NestJS only
API_PUBLIC_URL="http://localhost:4001"
WEB_PUBLIC_URL="http://localhost:3000"
ADMIN_PUBLIC_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# TRUST_PROXY="loopback"  # STALE — NestJS/Express only
NEXT_PUBLIC_API_URL="http://localhost:4001"
# API_URL="http://localhost:4001"  # Server-side URL for Next.js route handlers calling Go API
NEXT_PUBLIC_LOCAL_ADMIN_ACTOR_ID="00000000-0000-4000-8000-000000000001"
# Local/test-only authenticated admin browser QA bypass.
# Requires NODE_ENV!="production", localhost/127.0.0.1 API requests, and a seeded authz.admin_actor matching NEXT_PUBLIC_LOCAL_ADMIN_ACTOR_ID.
# Set both API/Admin app env vars together, then restart both dev servers:
# ADMIN_TEST_BYPASS="1"
# NEXT_PUBLIC_ADMIN_TEST_BYPASS="1"

REDIS_URL="redis://localhost:6379"
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="local_dev_meili_master_key"

MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="nihongo-bjt-media"
MINIO_USE_SSL="false"
# Browser-facing MinIO/S3 host used to sign presigned upload/download URLs.
# In production the internal MINIO_ENDPOINT is NOT reachable from the browser,
# so set these to the public host (reverse proxy / CDN). Leave unset for local dev.
# MINIO_PUBLIC_ENDPOINT="media.example.com"
# MINIO_PUBLIC_PORT="443"
# MINIO_PUBLIC_USE_SSL="true"
# Optional: comma-separated hostnames for server-side fetch when kanji stroke_svg_path is https (e.g. S3). MINIO_ENDPOINT, localhost, 127.0.0.1 are always allowed.
# KANJI_STROKE_SVG_FETCH_HOSTS="s3.ap-northeast-1.amazonaws.com"
# When stroke_svg_path is repo-relative (data/generated/kanji-strokes/<id>-<hex>.svg), the API resolves files under that folder. Set one of these if the process cwd is not the monorepo root (e.g. Docker): absolute path to repo root containing `data/generated/kanji-strokes/`.
# KANJI_STROKE_REPO_ROOT=""
# NIHONGO_BJT_REPO_ROOT=""

# Google OAuth (Phase 12). Required for /api/auth/google/* routes to work.
OAUTH_STATE_SECRET=""
ADS_DECISION_SIGNING_SECRET=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# M17: Keycloak OIDC variables removed — auth is Go-native sessions (M13a/b/c).
# All KEYCLOAK_* / NEXT_PUBLIC_KEYCLOAK_* vars are dead. Preserved in apps/api/ for rollback only.
# Optional comma-separated alias map from Keycloak roles to internal authz.admin_role codes. Default: admin:admin.super,superadmin:admin.super
KEYCLOAK_ADMIN_INTERNAL_ROLE_ALIASES=""

# BJT question image generation
# Providers: openai | omniroute | pollinations | xkiro
#   openai / omniroute  → inline OpenAI-compatible POST /images/generations (b64_json)
#   pollinations        → free inline image URL
#   xkiro               → asynchronous job API: POST /images/generations (202) then
#                         GET /images/generations/{id} until succeeded, image via CDN URL
IMAGE_PROVIDER="openai"
IMAGE_MODEL=""
IMAGE_API_BASE_URL=""
# Generic credential for the selected provider. An OpenAI key is never sent to
# xKiro (and vice versa): openai/omniroute fall back to OPENAI_API_KEY, xkiro to
# XKIRO_API_KEY.
IMAGE_API_KEY=""
IMAGE_WIDTH=""
IMAGE_HEIGHT=""
IMAGE_TIMEOUT_MS=""
IMAGE_MAX_ATTEMPTS=""
# Optional style hint forwarded to providers that accept one (xKiro).
IMAGE_STYLE=""
# Parallel image jobs. Default 3 for async-job providers (xkiro), 1 for inline
# providers so their per-request rate limits are respected.
IMAGE_CONCURRENCY=""
# Delay between requests inside one worker. Default 500ms for async-job
# providers, 3000ms for inline providers.
IMAGE_PACE_MS=""
# Async-job polling. Poll every few seconds, not every few hundred ms.
IMAGE_POLL_INTERVAL_MS=""
IMAGE_POLL_TIMEOUT_MS=""
# Resumable checkpoint of in-flight async jobs. A killed run resumes these job
# ids instead of paying for duplicate submissions.
IMAGE_JOB_CHECKPOINT=""

# xKiro (https://xkiro.com/dashboard/models) — pick the image model id there and
# put it in IMAGE_MODEL. Billing is one unit per image regardless of size;
# "blocked" (content-refused) jobs are still billed, "failed" ones are not.
# XKIRO_API_KEY="xk-..."
XKIRO_API_KEY=""

# Safety rail for data/generated/generate-ai-images.ts: writing image URLs into a
# non-local DATABASE_URL (i.e. production) requires this to be "true".
ALLOW_REMOTE_TARGET=""
# Regenerate questions that already have an AI image.
FORCE_REGENERATE=""
# Optional prompt translation/enrichment through an OpenAI-compatible text endpoint.
# Example free local route:
# IMAGE_PROMPT_TRANSLATION_BASE_URL="http://localhost:20128/v1"
# IMAGE_PROMPT_TRANSLATION_MODEL="nvidia/meta/llama-3.1-8b-instruct"
IMAGE_PROMPT_TRANSLATION_BASE_URL=""
IMAGE_PROMPT_TRANSLATION_MODEL=""
IMAGE_PROMPT_TRANSLATION_API_KEY=""
OPENAI_API_KEY=

# External image search providers (optional; local/dev falls back safely when unset)
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
